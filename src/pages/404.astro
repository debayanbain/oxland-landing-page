---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.tsx";
import { ArrowRight, ArrowLeft, Search, Home, Sparkles } from "lucide-react";
---
<Layout
  title="Page not found — Oxland"
  description="The page you were looking for doesn't exist. Head back to the Oxland homepage or explore the platform."
>
  <main class="relative isolate overflow-hidden pt-32 pb-24 sm:pt-40 sm:pb-32">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-grid-faint [background-size:44px_44px] opacity-40"></div>
      <div
        class="absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
        style="background: radial-gradient(closest-side, rgba(79,70,229,0.32), rgba(124,58,237,0.18) 50%, transparent 75%);"
      ></div>
      <img src="/cloud1.png" alt="" aria-hidden="true" class="absolute -top-4 left-[5%] w-[280px] opacity-65 blur-[2px] select-none" />
      <img src="/cloud2.png" alt="" aria-hidden="true" class="absolute top-32 right-[3%] w-[260px] opacity-55 blur-[1.5px] select-none" />
    </div>

    <div class="container relative">
      <div class="mx-auto max-w-2xl text-center">
        <Reveal client:visible variant="blur-up">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-indigo animate-pulse-soft"></span>
            404 · Page not found
          </div>
        </Reveal>

        <Reveal client:visible variant="blur-up" delay={0.08}>
          <h1 class="mt-6 font-display text-6xl font-extrabold leading-[1] tracking-tight text-brand-navy sm:text-7xl">
            The parcel you're looking for{" "}
            <span class="bg-gradient-to-r from-brand-blue via-brand-indigo to-brand-purple bg-clip-text text-transparent">
              doesn't exist here.
            </span>
          </h1>
        </Reveal>

        <Reveal client:visible variant="fade-up" delay={0.18}>
          <p class="mx-auto mt-6 max-w-lg text-base leading-relaxed text-brand-navy/65 sm:text-lg">
            The link may be broken or the page may have moved. Let's get you somewhere useful.
          </p>
        </Reveal>

        <Reveal client:visible variant="fade-up" delay={0.28}>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
            <a
              href="/"
              class="group inline-flex items-center gap-2 rounded-xl bg-brand-gradient px-6 py-3 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-float"
            >
              <Home size={14} strokeWidth={2.5} />
              Back to home
              <ArrowRight size={14} strokeWidth={2.5} class="transition-transform group-hover:translate-x-0.5" />
            </a>
            <a
              href="javascript:history.back()"
              class="inline-flex items-center gap-2 rounded-xl border border-brand-navy/12 bg-white/70 px-5 py-3 text-sm font-semibold text-brand-navy backdrop-blur-sm hover:bg-white"
            >
              <ArrowLeft size={14} strokeWidth={2.5} />
              Previous page
            </a>
          </div>
        </Reveal>

        {/* Quick-jump card grid */}
        <Reveal client:visible variant="fade-up" delay={0.38}>
          <div class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {[
              { href: "/features", label: "Features", palette: "text-brand-indigo bg-brand-indigo/10" },
              { href: "/pricing", label: "Pricing", palette: "text-emerald-600 bg-emerald-50" },
              { href: "/blog", label: "Blog", palette: "text-rose-600 bg-rose-50" },
              { href: "/contact", label: "Contact Us", palette: "text-brand-purple bg-brand-purple/10" },
            ].map((item) => (
              <a
                href={item.href}
                class="group flex items-center justify-between gap-2 rounded-2xl border border-brand-navy/10 bg-white p-3.5 text-left shadow-card transition-all hover:-translate-y-0.5 hover:shadow-float"
              >
                <div class="flex items-center gap-2.5">
                  <span class={`grid h-9 w-9 place-items-center rounded-xl ${item.palette}`}>
                    <Sparkles size={14} strokeWidth={2.5} />
                  </span>
                  <span class="text-sm font-bold text-brand-navy">{item.label}</span>
                </div>
                <ArrowRight
                  size={13}
                  strokeWidth={2.5}
                  class="text-brand-navy/35 transition-all group-hover:text-brand-indigo group-hover:translate-x-0.5"
                />
              </a>
            ))}
          </div>
        </Reveal>
      </div>
    </div>
  </main>
</Layout>
