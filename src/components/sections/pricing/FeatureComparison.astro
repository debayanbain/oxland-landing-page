---
import Reveal from "@/components/Reveal.tsx";
import { Check, Minus, Map, Gavel, Layers3, Coins, FileSearch, Plane, BarChart3, Lock, LifeBuoy } from "lucide-react";

type Cell = boolean | string;
type Row = { label: string; icon: any; freeEval: Cell; enterprise: Cell };

const rows: Row[] = [
  {
    label: "Parcel & Land Records",
    icon: Map,
    freeEval: "Up to 100 acres · 1 project",
    enterprise: "Unlimited parcels & projects",
  },
  {
    label: "Litigation & Case Management",
    icon: Gavel,
    freeEval: false,
    enterprise: true,
  },
  {
    label: "GIS, Cadastre & Surveying",
    icon: Layers3,
    freeEval: "Viewer only",
    enterprise: "Full engine · state-specific layers",
  },
  {
    label: "R&R, Compensation & Approvals",
    icon: Coins,
    freeEval: false,
    enterprise: true,
  },
  {
    label: "Documents, OCR & Workflow",
    icon: FileSearch,
    freeEval: "Storage only",
    enterprise: "Full OCR + workflows",
  },
  {
    label: "Drone, IoT & Field Intelligence",
    icon: Plane,
    freeEval: false,
    enterprise: true,
  },
  {
    label: "Reporting & Analytics",
    icon: BarChart3,
    freeEval: "Basic dashboards",
    enterprise: "Custom + audit-grade exports",
  },
  {
    label: "Security & Compliance",
    icon: Lock,
    freeEval: "RBAC · India residency",
    enterprise: "SSO/SCIM · on-prem · DPA",
  },
  {
    label: "Support & Onboarding",
    icon: LifeBuoy,
    freeEval: "Email",
    enterprise: "24×7 NOC · dedicated CSM",
  },
];
---

<section id="compare" class="relative py-16 sm:py-24">
  <div class="container">
    <Reveal client:visible>
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-indigo"></span>
          Compare plans
        </div>
        <h2 class="mt-5 font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-5xl">
          Every capability,{" "}
          <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">side by side.</span>
        </h2>
        <p class="mt-4 text-base text-brand-navy/60">
          Nine capability areas — the Free Evaluation gets you started, Enterprise unlocks the full platform.
        </p>
      </div>
    </Reveal>

    <Reveal client:visible delay={0.12}>
      <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-brand-navy/10 bg-white shadow-card">
        {/* Sticky header */}
        <div class="sticky top-4 z-20 grid grid-cols-[1.6fr_1fr_1fr] items-start gap-4 rounded-t-3xl border-b border-brand-navy/10 bg-white/95 backdrop-blur-md px-6 pt-6 pb-5 sm:px-8">
          <div class="pt-1 text-xs font-bold uppercase tracking-wider text-brand-navy/45">Capability</div>
          <div class="text-center">
            <div class="font-display text-base font-extrabold text-brand-navy leading-tight">Free Evaluation</div>
            <div class="mt-1.5 text-[11px] leading-tight text-brand-navy/45">14-day workspace</div>
          </div>
          <div class="text-center">
            <div class="inline-flex items-center gap-1.5 font-display text-base font-extrabold text-brand-indigo leading-tight">
              Enterprise
              <span class="rounded-full bg-brand-indigo/10 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-brand-indigo">Full</span>
            </div>
            <div class="mt-1.5 text-[11px] leading-tight text-brand-navy/45">Multi-site scale</div>
          </div>
        </div>

        {/* Rows */}
        <div class="divide-y divide-brand-navy/6">
          {rows.map((r) => (
            <div class="grid grid-cols-[1.6fr_1fr_1fr] items-center gap-4 px-6 py-5 transition-colors hover:bg-brand-indigo/[0.025] sm:px-8">
              {/* Capability */}
              <div class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-indigo/10 text-brand-indigo">
                  <r.icon size={16} strokeWidth={2.25} />
                </span>
                <span class="text-[14px] font-bold text-brand-navy">{r.label}</span>
              </div>

              {/* Free Evaluation */}
              <div class="flex items-center justify-center">
                {r.freeEval === true ? (
                  <span class="grid h-7 w-7 items-center justify-center rounded-full bg-brand-navy/8 text-brand-navy/70">
                    <Check size={13} strokeWidth={3} />
                  </span>
                ) : r.freeEval === false ? (
                  <span class="grid h-7 w-7 items-center justify-center rounded-full bg-brand-navy/6 text-brand-navy/35">
                    <Minus size={13} strokeWidth={3} />
                  </span>
                ) : (
                  <span class="text-center text-[12.5px] font-semibold text-brand-navy/75">
                    {r.freeEval}
                  </span>
                )}
              </div>

              {/* Enterprise */}
              <div class="flex items-center justify-center">
                {r.enterprise === true ? (
                  <span class="grid h-7 w-7 items-center justify-center rounded-full bg-brand-indigo text-white shadow-soft">
                    <Check size={13} strokeWidth={3} />
                  </span>
                ) : r.enterprise === false ? (
                  <span class="grid h-7 w-7 items-center justify-center rounded-full bg-brand-navy/6 text-brand-navy/35">
                    <Minus size={13} strokeWidth={3} />
                  </span>
                ) : (
                  <span class="text-center text-[12.5px] font-bold text-brand-indigo">
                    {r.enterprise}
                  </span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </div>
</section>
