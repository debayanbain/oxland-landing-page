---
import "@/styles/globals.css";
import SmoothScroll from "@/components/SmoothScroll.tsx";
import Navbar from "@/components/Navbar.tsx";
import Footer from "@/components/sections/Footer.astro";
import ContactModal from "@/components/ContactModal.tsx";
import PostHog from "@/components/Analytics/PostHog.astro";

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
  showNavbar?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = "Oxland — The Operating System for Modern Land Acquisition Teams",
  description = "Centralize parcel intelligence, acquisitions, litigation tracking, document workflows, GIS data, approvals, and reporting in a single platform.",
  showFooter = true,
  showNavbar = true,
  image = "/oxland.png",
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const jsonLdEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Safety net: if JS is disabled/blocked, framer-motion never runs, so every
         <Reveal> would stay at its initial opacity:0 and the page would look blank.
         Force reveal wrappers visible when there is no JS. -->
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Oxland" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {jsonLdEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body class="relative overflow-x-hidden bg-background">
    <SmoothScroll client:load />
    {showNavbar && <Navbar client:load />}
    <slot />
    {showFooter && <Footer />}
    <ContactModal client:load />
    <PostHog />
  </body>
</html>
