---
import Layout from "@/layouts/Layout.astro";
import PricingHero from "@/components/sections/pricing/PricingHero.astro";
import PricingPlans from "@/components/sections/pricing/PricingPlans.tsx";
import ValueStrip from "@/components/sections/pricing/ValueStrip.astro";
import FeatureComparison from "@/components/sections/pricing/FeatureComparison.astro";
import AddOnsGrid from "@/components/sections/pricing/AddOnsGrid.astro";
import ROICalculator from "@/components/sections/pricing/ROICalculator.tsx";
import PricingTestimonial from "@/components/sections/pricing/PricingTestimonial.astro";
import PricingFaq from "@/components/sections/pricing/PricingFaq.tsx";
import PricingCta from "@/components/sections/pricing/PricingCta.astro";
---
<Layout
  title="Pricing — Oxland | Plans for land acquisition, GIS & litigation teams"
  description="Transparent INR pricing for Oxland — the land acquisition, litigation and GIS operating system. Starter, Growth and Enterprise plans, modular add-ons and an ROI calculator built for Indian land operations."
>
  <main class="relative">
    <PricingHero />
    <PricingPlans client:visible />
    <ValueStrip />
    <FeatureComparison />
    <AddOnsGrid />
    <ROICalculator client:visible />
    <PricingTestimonial />
    <PricingFaq client:visible />
    <PricingCta />
  </main>
</Layout>
