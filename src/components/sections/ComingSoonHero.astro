---
import Reveal from "@/components/Reveal.tsx";
import { ArrowRight, Sparkles } from "lucide-react";

interface Props {
  eyebrow: string;
  title: string;
  titleAccent: string;
  description: string;
}

const { eyebrow, title, titleAccent, description } = Astro.props;
---

<section class="relative isolate overflow-hidden pt-36 pb-24 sm:pt-44 sm:pb-32">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-grid-faint [background-size:42px_42px] opacity-40"></div>
    <div
      class="absolute -top-40 left-1/2 h-[560px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(79,70,229,0.32), rgba(124,58,237,0.18) 50%, transparent 75%);"
    ></div>
    <img src="/cloud1.png" alt="" aria-hidden="true" class="absolute -top-4 left-[5%] w-[280px] opacity-65 blur-[2px] select-none" />
    <img src="/cloud2.png" alt="" aria-hidden="true" class="absolute top-32 right-[3%] w-[260px] opacity-55 blur-[1.5px] select-none" />
  </div>

  <div class="container relative">
    <div class="mx-auto max-w-3xl text-center">
      <Reveal client:visible variant="blur-up">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-indigo animate-pulse-soft"></span>
          {eyebrow}
        </div>
      </Reveal>

      <Reveal client:visible variant="blur-up" delay={0.08}>
        <h1 class="mt-6 font-display text-5xl font-extrabold leading-[1.05] tracking-tight text-brand-navy sm:text-6xl lg:text-[64px]">
          {title}{" "}
          <span class="bg-gradient-to-r from-brand-blue via-brand-indigo to-brand-purple bg-clip-text text-transparent">
            {titleAccent}
          </span>
        </h1>
      </Reveal>

      <Reveal client:visible variant="fade-up" delay={0.16}>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-brand-navy/65 sm:text-lg">
          {description}
        </p>
      </Reveal>

      <Reveal client:visible variant="fade-up" delay={0.24}>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-navy/10 bg-white/70 px-4 py-2 text-xs font-semibold text-brand-navy/70 backdrop-blur-sm shadow-[0_1px_0_rgba(255,255,255,0.7)_inset,0_2px_8px_-2px_rgba(11,20,55,0.08)]">
            <Sparkles size={12} class="text-brand-indigo" />
            We're writing it right now
          </div>
          <a
            href="/features"
            class="group inline-flex items-center gap-2 rounded-xl bg-brand-gradient px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-float"
          >
            Explore the product
            <ArrowRight
              size={14}
              strokeWidth={2.5}
              class="transition-transform group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>
