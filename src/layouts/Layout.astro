---
import "@/styles/globals.css";
import SmoothScroll from "@/components/SmoothScroll.tsx";
import Navbar from "@/components/Navbar.tsx";
import Footer from "@/components/sections/Footer.astro";
import ContactModal from "@/components/ContactModal.tsx";
import PostHog from "@/components/Analytics/PostHog.astro";

interface Props {
  title?: string;
  description?: string;
  showFooter?: boolean;
  showNavbar?: boolean;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = "Oxland — The Operating System for Modern Land Acquisition Teams",
  description = "Centralize parcel intelligence, acquisitions, litigation tracking, document workflows, GIS data, approvals, and reporting in a single platform.",
  showFooter = true,
  showNavbar = true,
  image = "/oxland.png",
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const jsonLdEntries = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-C4620RB5D0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-C4620RB5D0');

      // Lightweight click tracking — no GTM, no per-button wiring.
      // Tracks EVERY button automatically; elements with data-track="event_name"
      // get that clean name, everything else logs as "button_click" + its text.
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track], button, [role="button"], input[type="submit"]');
        if (!el) return;
        var name = el.getAttribute('data-track') || 'button_click';
        var text = (el.innerText || el.value || el.getAttribute('aria-label') || '').trim().slice(0, 100);
        gtag('event', name, { button_text: text });
        if (window.clarity) window.clarity('event', name);
      }, true);
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "zfj9jf4lw1");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#000000" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Safety net: if JS is disabled/blocked, framer-motion never runs, so every
         <Reveal> would stay at its initial opacity:0 and the page would look blank.
         Force reveal wrappers visible when there is no JS. -->
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; filter: none !important; }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Oxland" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {jsonLdEntries.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body class="relative overflow-x-hidden bg-background">
    <SmoothScroll client:load />
    {showNavbar && <Navbar client:load />}
    <slot />
    {showFooter && <Footer />}
    <ContactModal client:load />
    <PostHog />
  </body>
</html>
