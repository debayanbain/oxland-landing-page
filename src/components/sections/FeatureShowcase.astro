---
import Reveal, { RevealGroup, RevealItem } from "@/components/Reveal.tsx";
import ScrollScale from "@/components/ScrollScale.tsx";
import Icon from "@/components/Icon.astro";

const features = [
  { icon: "handshake", label: "Land Acquisition" },
  { icon: "map", label: "Parcel Tracking" },
  { icon: "scale", label: "Litigation Management" },
  { icon: "route", label: "Proposal Workflow" },
  { icon: "layers", label: "GIS Layer Integration" },
  { icon: "upload", label: "Document Uploads" },
  { icon: "trending", label: "Reporting & Analytics" },
  { icon: "users", label: "Team Collaboration" },
];
---
<section id="solutions" class="relative py-8 sm:py-10">
  <div class="container grid items-center gap-14 lg:grid-cols-2">
    <Reveal client:visible variant="blur-up" className="order-2 lg:order-1">
      <span class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-indigo/70">Platform</span>
      <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-5xl">
        Everything your land team needs, in one place
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-brand-navy/60">
        Say goodbye to scattered spreadsheets and disconnected tools. Oxland unifies acquisitions,
        parcels, litigation, documents and GIS into one intelligent workspace.
      </p>
      <RevealGroup client:visible stagger={0.05} delay={0.1} className="mt-8 grid grid-cols-2 gap-3">
        {features.map((f) => (
          <RevealItem variant="blur-up" y={16}>
            <div class="flex items-center gap-3 rounded-xl border border-border bg-white/70 px-3.5 py-3 backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-brand-indigo/30 hover:shadow-card">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-secondary text-brand-indigo">
                <Icon name={f.icon} size={18} />
              </span>
              <span class="text-sm font-semibold text-brand-navy">{f.label}</span>
            </div>
          </RevealItem>
        ))}
      </RevealGroup>
    </Reveal>

    <ScrollScale client:visible from={0.9} lift={50} className="order-1 lg:order-2">
      <div class="relative">
        {/* Dashboard card — light, brand-matched */}
        <div class="dash-card relative overflow-hidden rounded-[24px] border border-slate-200/80 bg-white shadow-[0_32px_80px_-24px_rgba(47,71,160,0.28),0_8px_32px_-8px_rgba(124,58,237,0.12)]">

          {/* Top gradient accent bar */}
          <div class="h-[3px] w-full bg-gradient-to-r from-[#2F5BFF] via-[#7C3AED] to-[#10B981]"></div>

          {/* Header */}
          <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/80 px-5 py-3.5">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-70" style="animation-duration:2s"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
              </span>
              <span class="font-display text-[13px] font-bold tracking-tight text-brand-navy">Acquisition Intelligence</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-600">Live</span>
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-medium text-brand-navy/40">Jun 2025</span>
            </div>
          </div>

          <div class="p-5">

            {/* KPI stat tiles */}
            <div class="grid grid-cols-3 gap-2 mb-5">
              {[
                { label: "Total Parcels", value: "350",  sub: "+18.6%", subColor: "#059669", accent: "rgba(16,185,129,0.07)", border: "rgba(16,185,129,0.2)",
                  sparkPath: "M0 18 L8 14 L16 16 L24 10 L32 12 L40 6 L48 8 L56 2", sparkColor: "#10B981" },
                { label: "Coverage",      value: "67 ac", sub: "+4.2%",  subColor: "#2F5BFF", accent: "rgba(47,91,255,0.06)",  border: "rgba(47,91,255,0.18)",
                  sparkPath: "M0 16 L8 12 L16 14 L24 8 L32 10 L40 5 L48 7 L56 3", sparkColor: "#2F5BFF" },
                { label: "Budget Used",   value: "₹1.2M", sub: "82% utilized", subColor: "#7C3AED", accent: "rgba(124,58,237,0.06)", border: "rgba(124,58,237,0.18)",
                  sparkPath: "M0 14 L8 10 L16 12 L24 7 L32 9 L40 4 L48 6 L56 2", sparkColor: "#7C3AED" },
              ].map((stat) => (
                <div
                  class="relative overflow-hidden rounded-xl border p-3 transition-transform hover:-translate-y-0.5"
                  style={`background: ${stat.accent}; border-color: ${stat.border}`}
                >
                  <div class="text-[9px] font-semibold uppercase tracking-widest text-brand-navy/45 mb-1">{stat.label}</div>
                  <div class="font-display text-xl font-extrabold text-brand-navy leading-none">{stat.value}</div>
                  <div class="mt-1 text-[10px] font-bold" style={`color: ${stat.subColor}`}>{stat.sub}</div>
                  {/* Mini sparkline */}
                  <div class="absolute bottom-2 right-2 opacity-50">
                    <svg width="56" height="20" viewBox="0 0 56 20" fill="none" aria-hidden="true">
                      <path d={stat.sparkPath} stroke={stat.sparkColor} stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
              ))}
            </div>

            {/* Pipeline header */}
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold uppercase tracking-widest text-brand-navy/45">Acquisition Pipeline</span>
              <span class="text-[10px] text-brand-navy/30">350 parcels total</span>
            </div>

            {/* Pipeline — donut chart */}
            <div class="flex items-center gap-4">
              {/* Donut SVG */}
              <div class="relative h-[110px] w-[110px] shrink-0">
                <svg viewBox="0 0 130 130" class="donut-svg h-full w-full" aria-hidden="true">
                  <circle cx="65" cy="65" r="52" fill="none" stroke="rgb(241 245 249)" stroke-width="16"/>
                  <circle class="donut-seg seg-0" cx="65" cy="65" r="52" fill="none" stroke="#2F5BFF" stroke-width="16" stroke-dasharray="132.17 194.56" stroke-dashoffset="326.73"/>
                  <circle class="donut-seg seg-1" cx="65" cy="65" r="52" fill="none" stroke="#7C3AED" stroke-width="16" stroke-dasharray="88.11 238.62"  stroke-dashoffset="191.56"/>
                  <circle class="donut-seg seg-2" cx="65" cy="65" r="52" fill="none" stroke="#A78BFA" stroke-width="16" stroke-dasharray="56.65 270.08"  stroke-dashoffset="100.45"/>
                  <circle class="donut-seg seg-3" cx="65" cy="65" r="52" fill="none" stroke="#10B981" stroke-width="16" stroke-dasharray="37.77 288.96"  stroke-dashoffset="40.79"/>
                </svg>
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                  <span class="text-[19px] font-extrabold leading-none text-brand-navy">350</span>
                  <span class="mt-0.5 text-[9px] font-medium text-brand-navy/40">parcels</span>
                </div>
              </div>
              {/* Legend */}
              <div class="flex flex-1 flex-col gap-[9px]">
                {[
                  { s: "Identified",        v: 147, color: "#2F5BFF", tagBg: "rgba(47,91,255,0.1)",    tagColor: "#2F5BFF", tag: "Active"      },
                  { s: "Under Negotiation", v: 98,  color: "#7C3AED", tagBg: "rgba(124,58,237,0.1)",   tagColor: "#7C3AED", tag: "In Progress" },
                  { s: "Documentation",     v: 63,  color: "#A78BFA", tagBg: "rgba(167,139,250,0.12)", tagColor: "#7C3AED", tag: "Review"      },
                  { s: "Closed",            v: 42,  color: "#10B981", tagBg: "rgba(16,185,129,0.1)",   tagColor: "#059669", tag: "Done"        },
                ].map((row) => (
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <span class="h-2 w-2 rounded-full" style={`background:${row.color}`}></span>
                      <span class="text-[10.5px] font-medium text-brand-navy/65">{row.s}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="rounded-md px-1.5 py-0.5 text-[9px] font-bold" style={`background:${row.tagBg};color:${row.tagColor}`}>{row.tag}</span>
                      <span class="text-[11px] font-bold text-brand-navy">{row.v}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Activity feed */}
            <div class="mt-5 border-t border-slate-100 pt-4">
              <div class="text-[9px] font-bold uppercase tracking-widest text-brand-navy/35 mb-3">Recent Activity</div>
              <div class="space-y-2">
                {[
                  { msg: "Parcel KA-441 — owner meeting confirmed", time: "2m ago",  dot: "#10B981" },
                  { msg: "Litigation #LC-089 — status updated",      time: "1h ago",  dot: "#F59E0B" },
                  { msg: "Survey report uploaded · Plot 128",         time: "3h ago",  dot: "#2F5BFF" },
                ].map((a) => (
                  <div class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 transition-colors hover:bg-slate-50">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${a.dot}`}></span>
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-[11px] text-brand-navy/60">{a.msg}</div>
                    </div>
                    <div class="shrink-0 text-[9px] font-medium text-brand-navy/30">{a.time}</div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      </div>
    </ScrollScale>
  </div>
</section>

<style>
  .donut-svg { transform: rotate(-90deg); display: block; }

  .donut-seg { opacity: 0; transition: opacity 0.45s ease; }

  .dash-card.in-view .seg-0 { opacity: 1; transition-delay: 0s; }
  .dash-card.in-view .seg-1 { opacity: 1; transition-delay: 0.13s; }
  .dash-card.in-view .seg-2 { opacity: 1; transition-delay: 0.26s; }
  .dash-card.in-view .seg-3 { opacity: 1; transition-delay: 0.39s; }
</style>

<script>
  (function () {
    const cards = document.querySelectorAll(".dash-card");
    if (cards.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
          } else {
            entry.target.classList.remove("in-view");
          }
        });
      },
      { threshold: 0.15 }
    );

    cards.forEach((card) => observer.observe(card));
  })();
</script>
