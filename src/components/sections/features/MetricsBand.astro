---
import Reveal from "@/components/Reveal.tsx";
import CountUp from "@/components/CountUp.tsx";
import { Rocket, FileText, Orbit, BrainCircuit } from "lucide-react";

type Metric = {
  icon: any;
  to?: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  separator?: boolean;
  staticText?: string;
  label: string;
  detail: string;
};

const metrics: Metric[] = [
  { icon: Rocket, to: 70, suffix: "%+", separator: false, label: "Faster Land Acquisition", detail: "Accelerate acquisition through GIS-driven workflows." },
  { icon: FileText, to: 90, suffix: "%+", separator: false, label: "Reduced Manual Documentation", detail: "Digitize records and automate document management." },
  { icon: Orbit, to: 360, suffix: "°", separator: false, label: "Land Lifecycle Management", detail: "One platform for acquisition, records, litigation and R&R." },
  { icon: BrainCircuit, staticText: "GeoAI", label: "Decision Intelligence", detail: "Transform land and spatial data into actionable insights." },
];
---

<section class="relative py-10 sm:py-14">
  <div class="container">
    <Reveal client:visible>
      <div class="relative overflow-hidden rounded-[32px] border border-brand-navy/10 bg-brand-navy shadow-float">
        <div class="pointer-events-none absolute inset-0 opacity-[0.08]" style="background-image: linear-gradient(to right, rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 44px 44px;"></div>
        <div class="pointer-events-none absolute -top-32 -left-20 h-80 w-80 rounded-full blur-3xl opacity-60" style="background: radial-gradient(closest-side, rgba(79,70,229,0.55), transparent 70%);"></div>
        <div class="pointer-events-none absolute -bottom-32 -right-20 h-80 w-80 rounded-full blur-3xl opacity-50" style="background: radial-gradient(closest-side, rgba(124,58,237,0.55), transparent 70%);"></div>

        <div class="relative grid grid-cols-2 divide-x divide-white/10 lg:grid-cols-4">
          {metrics.map((m, i) => (
            <div class={`group relative px-6 py-10 sm:px-8 ${i >= 2 ? "border-t border-white/10 lg:border-t-0" : ""}`}>
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-brand-lavender ring-1 ring-white/15 backdrop-blur-md">
                <m.icon size={16} strokeWidth={2.25} />
              </span>
              <div class="mt-5 flex items-baseline gap-1">
                {m.staticText ? (
                  <span class="font-display text-4xl font-extrabold tracking-tight bg-gradient-to-r from-white via-brand-lavender to-white bg-clip-text text-transparent sm:text-5xl">
                    {m.staticText}
                  </span>
                ) : (
                  <CountUp
                    client:visible
                    to={m.to ?? 0}
                    decimals={m.decimals ?? 0}
                    prefix={m.prefix ?? ""}
                    suffix={m.suffix ?? ""}
                    separator={m.separator ?? true}
                    className="font-display text-4xl font-extrabold tracking-tight bg-gradient-to-r from-white via-brand-lavender to-white bg-clip-text text-transparent tabular-nums sm:text-5xl"
                  />
                )}
              </div>
              <p class="mt-3 text-sm font-semibold text-white">{m.label}</p>
              <p class="mt-1 text-xs leading-relaxed text-white/55">{m.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </Reveal>
  </div>
</section>
