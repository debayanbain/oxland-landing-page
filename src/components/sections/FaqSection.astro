---
import Reveal from "@/components/Reveal.tsx";
import Faq from "@/components/Faq.tsx";
---
<section id="pricing" class="relative py-8 sm:py-10">
  <div class="container">
    <Reveal client:visible>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-5xl">
          Frequently asked questions
        </h2>
        <p class="mt-4 text-lg text-brand-navy/60">Everything you need to know to get your land operation running.</p>
      </div>
    </Reveal>
    <div class="mt-12">
      <Faq client:visible />
    </div>
  </div>
</section>
