---
import Reveal from "@/components/Reveal.tsx";
import { Phone, Mail, MapPin, Linkedin, Facebook, Youtube } from "lucide-react";

const PLATFORM = [
  { label: "GIS Based Land Mapping", id: "gis" },
  { label: "Digital Land Records", id: "records" },
  { label: "Ownership Management", id: "ownership" },
  { label: "Land Acquisition Management", id: "acquisition" },
  { label: "Litigation Management", id: "litigation" },
  { label: "R&R Management", id: "rr" },
];

const OPERATIONS = [
  { label: "Land Rate & Valuation", id: "valuation" },
  { label: "Encroachment Detection", id: "encroachment" },
  { label: "Document Workflow & Approvals", id: "workflow" },
  { label: "Alerts & Notifications", id: "alerts" },
  { label: "Easy Integrations", id: "integrations" },
  { label: "Simple Data Upload", id: "upload" },
];

const COMPANY = [
  { label: "About Us", href: "/about" },
  { label: "Contact Us", href: "/contact" },
  { label: "Pricing", href: "/pricing" },
  { label: "Blog", href: "/blog" },
];

const OFFICES = [
  { city: "Kolkata", tag: "Corporate", line: "242, R.A.K Road, Kolkata, West Bengal 700055" },
  { city: "Kalinganagar", tag: "Operations", line: "Near Duburi Chowk, Kalinganagar, Jajpur 755026" },
];

// LinkedIn is live; Facebook / YouTube URLs pending — update hrefs when provided.
const SOCIALS = [
  { label: "LinkedIn", href: "https://www.linkedin.com/products/oxbow-intellect-oxland-land-litigation-management-system/", icon: Linkedin, external: true },
  { label: "Facebook", href: "#", icon: Facebook, external: false },
  { label: "YouTube", href: "#", icon: Youtube, external: false },
];
---
<footer class="relative border-t border-border bg-white/60 backdrop-blur-sm">
  <div class="container py-14">
    {/* CONTACT STRIP — full-width, sits at the top of the footer */}
    <Reveal client:visible>
      <div class="grid gap-x-8 gap-y-5 border-b border-border pb-10 sm:grid-cols-2 lg:grid-cols-4">
        <a href="tel:+919064696958" class="group flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-indigo/10 text-brand-indigo">
            <Phone size={16} strokeWidth={2.25} />
          </span>
          <span>
            <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy/45">Call us</span>
            <span class="block text-sm font-semibold text-brand-navy transition-colors group-hover:text-brand-indigo">+91 90646 96958</span>
          </span>
        </a>

        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-indigo/10 text-brand-indigo">
            <Mail size={16} strokeWidth={2.25} />
          </span>
          <span class="min-w-0">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy/45">Email us</span>
            <a href="mailto:info@oxbowintellect.com" class="block truncate text-sm font-semibold text-brand-navy transition-colors hover:text-brand-indigo">info@oxbowintellect.com</a>
            <a href="mailto:info@oxland.in" class="block truncate text-sm font-semibold text-brand-navy transition-colors hover:text-brand-indigo">info@oxland.in</a>
          </span>
        </div>

        {OFFICES.map((o, i) => (
          <div class="flex items-start gap-3">
            <span class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-indigo/10 text-brand-indigo">
              <MapPin size={16} strokeWidth={2.25} />
            </span>
            <span>
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy/45">{o.tag} · {o.city}</span>
              <span class="block text-[13px] leading-snug text-brand-navy/70">{o.line}</span>
            </span>
          </div>
        ))}
      </div>
    </Reveal>

    <Reveal client:visible delay={0.08}>
      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_2.6fr]">
        {/* LEFT — logo + tagline + newsletter + socials */}
        <div>
          <img src="/oxland.svg" alt="oxland logo" height={28} width={120} />
          <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-navy/55">
            The operating system for modern land acquisition and management teams.
          </p>

          <div class="mt-6">
            <label class="text-xs font-semibold text-brand-navy/70">Stay updated</label>
            <div class="mt-2 flex max-w-sm items-center gap-2 rounded-full border border-border bg-white p-1.5 pl-4">
              <input type="email" placeholder="Your email address" class="w-full bg-transparent text-sm text-brand-navy outline-none placeholder:text-brand-navy/40" />
              <button class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-gradient text-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </div>
          </div>

          {/* Socials */}
          <div class="mt-6 flex items-center gap-2.5">
            {SOCIALS.map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                target={s.external ? "_blank" : undefined}
                rel={s.external ? "noopener noreferrer" : undefined}
                class="grid h-9 w-9 place-items-center rounded-lg border border-brand-navy/10 bg-white text-brand-navy/55 transition-all hover:-translate-y-0.5 hover:border-brand-indigo/40 hover:text-brand-indigo hover:shadow-soft"
              >
                <s.icon size={16} strokeWidth={2} />
              </a>
            ))}
          </div>
        </div>

        {/* RIGHT — Platform + Operations + Company */}
        <div class="grid gap-8 sm:grid-cols-3">
          {/* Platform */}
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy/45">Platform</h4>
            <ul class="mt-5 space-y-2.5">
              {PLATFORM.map((f) => (
                <li>
                  <a
                    href={`/features#${f.id}`}
                    class="text-sm text-brand-navy/65 transition-colors hover:text-brand-indigo"
                  >
                    {f.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Operations */}
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy/45">Operations</h4>
            <ul class="mt-5 space-y-2.5">
              {OPERATIONS.map((f) => (
                <li>
                  <a
                    href={`/features#${f.id}`}
                    class="text-sm text-brand-navy/65 transition-colors hover:text-brand-indigo"
                  >
                    {f.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Company */}
          <div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy/45">Company</h4>
            <ul class="mt-5 space-y-2.5">
              {COMPANY.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="text-sm text-brand-navy/65 transition-colors hover:text-brand-indigo"
                  >
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </Reveal>

    {/* BOTTOM BAR */}
    <Reveal client:visible delay={0.16}>
      <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-border pt-6 sm:flex-row">
        <p class="text-xs text-brand-navy/50">© 2026 Oxland. All rights reserved.</p>
        <div class="flex items-center gap-5 text-xs text-brand-navy/50">
          <a href="#" class="transition-colors hover:text-brand-indigo">Privacy Policy</a>
          <a href="#" class="transition-colors hover:text-brand-indigo">Terms</a>
          <a href="/contact" class="transition-colors hover:text-brand-indigo">Contact</a>
        </div>
      </div>
    </Reveal>
  </div>
</footer>
