---
import Reveal from "@/components/Reveal.tsx";
import ScrollScale from "@/components/ScrollScale.tsx";
import IntegrationsOrbit from "@/components/IntegrationsOrbit.tsx";
import { Plug, ShieldCheck, Zap, LineChart, Lock } from "lucide-react";
---
<section id="integrations" class="relative py-12 sm:py-16">
  <div class="container">
    <Reveal client:visible variant="scale">
      <div class="relative overflow-hidden rounded-[36px] bg-[#f3f6fd] bg-[url('/BG-oxland.webp')] bg-cover bg-center px-6 py-12 shadow-float sm:px-12 sm:py-16 lg:px-16 lg:py-20">
        
        {/* Ambient background glows inside the box */}
        <div class="pointer-events-none absolute -left-[150px] -bottom-[150px] z-10 h-[600px] w-[600px] rounded-full bg-[radial-gradient(circle,rgba(168,85,247,0.18)_0%,rgba(168,85,247,0)_70%)] filter blur-[100px]"></div>
        <div class="pointer-events-none absolute -right-[100px] -top-[50px] z-10 h-[600px] w-[600px] rounded-full bg-[radial-gradient(circle,rgba(59,130,246,0.14)_0%,rgba(59,130,246,0)_70%)] filter blur-[100px]"></div>
        <div class="pointer-events-none absolute left-[5%] top-[25%] z-10 h-[500px] w-[500px] rounded-full bg-[radial-gradient(circle,rgba(236,72,153,0.08)_0%,rgba(236,72,153,0)_70%)] filter blur-[100px]"></div>

        <div class="relative z-20 flex flex-col items-center">
          {/* Orbit Visual Wrapper */}
          <ScrollScale client:visible from={0.9} lift={40} className="w-full flex justify-center overflow-visible">
            <IntegrationsOrbit client:load />
          </ScrollScale>

          {/* Bottom Glassmorphic Panel */}
          <Reveal client:visible variant="blur-up" className="w-full flex justify-center mt-8">
            <div class="w-full max-w-[1000px] bg-white/40 backdrop-blur-xl border border-white/60 shadow-float rounded-[24px] p-6 sm:p-8 grid grid-cols-1 md:grid-cols-4 gap-6 relative">
              {/* Column 1 */}
              <div class="flex items-center gap-4 md:px-3 md:relative md:after:content-[''] md:after:absolute md:after:right-0 md:after:top-[10%] md:after:h-[80%] md:after:w-[1px] md:after:bg-gradient-to-b md:after:from-transparent md:after:via-brand-purple/15 md:after:to-transparent md:after:hidden md:md:after:block">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-purple/10 text-brand-purple shadow-[0_4px_16px_rgba(126,34,206,0.15)]">
                  <Plug size={22} strokeWidth={2.5} />
                </div>
                <div class="flex flex-col">
                  <h3 class="text-[14px] font-extrabold leading-tight text-brand-navy">
                    Seamless <br /> Integrations
                  </h3>
                  <p class="mt-1 text-[11px] font-semibold text-brand-navy/60 leading-snug">
                    Connect in minutes <br /> with no code.
                  </p>
                </div>
              </div>

              {/* Column 2 */}
              <div class="flex items-center gap-4 md:px-3 md:relative md:after:content-[''] md:after:absolute md:after:right-0 md:after:top-[10%] md:after:h-[80%] md:after:w-[1px] md:after:bg-gradient-to-b md:after:from-transparent md:after:via-brand-purple/15 md:after:to-transparent md:after:hidden md:md:after:block">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-500/10 text-blue-600 shadow-[0_4px_16px_rgba(59,130,246,0.15)]">
                  <ShieldCheck size={22} strokeWidth={2.5} />
                </div>
                <div class="flex flex-col">
                  <h3 class="text-[14px] font-extrabold leading-tight text-brand-navy flex items-center gap-1">
                    Secure
                    <span class="inline-flex text-blue-600">
                      <Lock size={10} strokeWidth={3} />
                    </span>
                    <br /> Reliable
                  </h3>
                  <p class="mt-1 text-[11px] font-semibold text-brand-navy/60 leading-snug">
                    Enterprise-grade <br /> security you can trust.
                  </p>
                </div>
              </div>

              {/* Column 3 */}
              <div class="flex items-center gap-4 md:px-3 md:relative md:after:content-[''] md:after:absolute md:after:right-0 md:after:top-[10%] md:after:h-[80%] md:after:w-[1px] md:after:bg-gradient-to-b md:after:from-transparent md:after:via-brand-purple/15 md:after:to-transparent md:after:hidden md:md:after:block">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-indigo/10 text-brand-indigo shadow-[0_4px_16px_rgba(79,70,229,0.15)]">
                  <Zap size={22} strokeWidth={2.5} />
                </div>
                <div class="flex flex-col">
                  <h3 class="text-[14px] font-extrabold leading-tight text-brand-navy">
                    Automate <br /> Workflows
                  </h3>
                  <p class="mt-1 text-[11px] font-semibold text-brand-navy/60 leading-snug">
                    Sync data and save <br /> hours of manual work.
                  </p>
                </div>
              </div>

              {/* Column 4 */}
              <div class="flex items-center gap-4 md:px-3">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 shadow-[0_4px_16px_rgba(16,185,129,0.15)]">
                  <LineChart size={22} strokeWidth={2.5} />
                </div>
                <div class="flex flex-col">
                  <h3 class="text-[14px] font-extrabold leading-tight text-brand-navy">
                    Boost <br /> Productivity
                  </h3>
                  <p class="mt-1 text-[11px] font-semibold text-brand-navy/60 leading-snug">
                    One platform. All tools. <br /> Maximum impact.
                  </p>
                </div>
              </div>
            </div>
          </Reveal>
        </div>

      </div>
    </Reveal>
  </div>
</section>
