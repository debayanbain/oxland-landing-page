---
import Reveal from "@/components/Reveal.tsx";
import Magnetic from "@/components/Magnetic.tsx";
import { Button } from "@/components/ui/button";
import { ArrowRight, Sparkles, Play, Newspaper } from "lucide-react";
---

<section class="relative py-16 sm:py-24">
  <div class="container">
    <Reveal client:visible variant="scale">
      <div class="relative overflow-hidden rounded-[40px] bg-brand-navy">
        {/* Ambient */}
        <div class="pointer-events-none absolute inset-0">
          <div
            class="absolute -top-32 -left-20 h-[420px] w-[420px] rounded-full blur-3xl opacity-55"
            style="background: radial-gradient(closest-side, rgba(79,70,229,0.55), transparent 70%);"
          ></div>
          <div
            class="absolute -bottom-40 -right-20 h-[480px] w-[480px] rounded-full blur-3xl opacity-50"
            style="background: radial-gradient(closest-side, rgba(124,58,237,0.55), transparent 70%);"
          ></div>
          <div
            class="absolute inset-0 opacity-[0.06]"
            style="background-image: linear-gradient(to right, rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 48px 48px;"
          ></div>
        </div>

        <div class="relative grid items-center gap-10 px-8 py-16 lg:grid-cols-[1.4fr_1fr] lg:px-16 lg:py-20">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-md px-3 py-1 text-xs font-semibold uppercase tracking-widest text-white/90 ring-1 ring-white/20">
              <Sparkles size={11} />
              Not ready to talk yet?
            </span>

            <h2 class="mt-6 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
              Explore the product{" "}
              <span class="bg-gradient-to-r from-brand-lavender via-white to-brand-lavender bg-clip-text text-transparent">on your own terms.</span>
            </h2>

            <p class="mt-6 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg">
              Take a tour of the full platform, browse the features page, or download the product one-pager — no meetings, no forms.
            </p>

            <div class="mt-9 flex flex-wrap items-center gap-4">
              <Magnetic client:visible strength={0.15}>
                <a href="/features" class="group inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-navy shadow-soft transition-all hover:bg-white/90">
                  <Play class="h-4 w-4 text-brand-indigo" />
                  Take the product tour
                  <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
                </a>
              </Magnetic>
              <a
                href="#"
                class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/10"
              >
                <Newspaper class="h-4 w-4" />
                Download the one-pager (PDF)
              </a>
            </div>
          </div>

          {/* Right — floating stat cards */}
          <div class="relative grid gap-3">
            <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-4 backdrop-blur-md">
              <div class="text-[10px] font-bold uppercase tracking-wider text-white/60">Global reach</div>
              <div class="mt-1 font-display text-2xl font-extrabold text-white">14 PSUs · 32 developers</div>
              <div class="mt-0.5 text-[11px] text-white/55">Across 18 Indian states + 4 UTs</div>
            </div>
            <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-4 backdrop-blur-md">
              <div class="text-[10px] font-bold uppercase tracking-wider text-white/60">Compliance</div>
              <div class="mt-1 font-display text-lg font-extrabold text-white">SOC 2 · ISO 27001 · DPDP</div>
              <div class="mt-0.5 text-[11px] text-white/55">MeitY empanelled · GeM & CPP-ready</div>
            </div>
            <div class="rounded-2xl border border-white/15 bg-white/[0.06] p-4 backdrop-blur-md">
              <div class="text-[10px] font-bold uppercase tracking-wider text-white/60">Data residency</div>
              <div class="mt-1 font-display text-lg font-extrabold text-white">India-region · on-prem ready</div>
              <div class="mt-0.5 text-[11px] text-white/55">NIC / CDAC cloud supported</div>
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
