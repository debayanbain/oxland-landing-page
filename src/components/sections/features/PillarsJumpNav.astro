---
import { Map, FileText, Pipette, Plane, ScanText, ShieldCheck } from "lucide-react";

const pillars = [
  { id: "gis", label: "GIS Mapping", icon: Map },
  { id: "records", label: "Records & Ownership", icon: FileText },
  { id: "acquisition", label: "Acquisition Pipeline", icon: Pipette },
  { id: "fieldops", label: "Field Operations", icon: Plane },
  { id: "documents", label: "Documents & Litigation", icon: ScanText },
  { id: "security", label: "Alerts & Security", icon: ShieldCheck },
];
---

<section id="pillars" class="relative pt-10 pb-12 sm:pt-14 sm:pb-16">
  <div class="container">
    <div class="overflow-hidden rounded-full border border-brand-navy/8 bg-white/70 backdrop-blur-md shadow-card">
      <div class="flex items-center gap-1 overflow-x-auto p-1.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {pillars.map((p, i) => (
          <a
            href={`#${p.id}`}
            class="group flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-[13px] font-semibold text-brand-navy/70 transition-all hover:bg-brand-indigo/8 hover:text-brand-indigo"
          >
            <span class="grid h-6 w-6 place-items-center rounded-full bg-brand-indigo/10 text-brand-indigo transition-all group-hover:bg-brand-indigo group-hover:text-white">
              <p.icon size={11} strokeWidth={2.5} />
            </span>
            <span class="whitespace-nowrap">
              <span class="mr-1.5 text-[10px] font-bold text-brand-indigo/60">0{i + 1}</span>
              {p.label}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
