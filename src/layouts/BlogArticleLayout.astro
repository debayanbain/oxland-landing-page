---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.tsx";
import BlogSidebar from "@/components/BlogSidebar.tsx";
import ShareMenu from "@/components/ShareMenu.tsx";
import { ArrowLeft, ArrowRight, Clock, Calendar, Bookmark } from "lucide-react";

interface Author {
  name: string;
  role: string;
  initials: string;
  bio: string;
  socials: {
    linkedin?: string;
    instagram?: string;
    facebook?: string;
    twitter?: string;
  };
}

interface Post {
  category: string;
  categoryPalette: string;
  title: string;
  subtitle: string;
  date: string;
  isoDate?: string; // ISO date for JSON-LD (falls back to date if omitted)
  readTime: string;
  image: string;
  slug: string;
}

interface RelatedPost {
  href: string;
  title: string;
  category: string;
  excerpt: string;
  image: string;
  readTime: string;
}

interface Props {
  post: Post;
  author: Author;
  related?: RelatedPost[];
}

const { post, author, related = [] } = Astro.props;

const shareUrl = `https://oxland.in/blog/${post.slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.subtitle,
  image: `https://oxland.in${post.image}`,
  datePublished: post.isoDate ?? post.date,
  author: {
    "@type": "Person",
    name: author.name,
  },
  publisher: {
    "@type": "Organization",
    name: "Oxland",
    logo: {
      "@type": "ImageObject",
      url: "https://oxland.in/oxland.svg",
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://oxland.in/blog/${post.slug}`,
  },
};
---
<Layout title={`${post.title} — Oxland Blog`} description={post.subtitle}>
  <main class="relative">

    {/* ARTICLE HEADER */}
    <section class="relative z-20 isolate pt-28 pb-8 sm:pt-32 sm:pb-12">
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute inset-0 bg-grid-faint [background-size:42px_42px] opacity-30"></div>
        <div
          class="absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full opacity-50 blur-3xl"
          style="background: radial-gradient(closest-side, rgba(79,70,229,0.28), rgba(124,58,237,0.14) 50%, transparent 75%);"
        ></div>
      </div>

      <div class="container relative">
        <Reveal client:visible variant="fade-up">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-brand-navy/55 transition-colors hover:text-brand-indigo"
          >
            <ArrowLeft size={13} strokeWidth={2.5} />
            Back to blog
          </a>
        </Reveal>

        <div class="mx-auto mt-6 max-w-3xl">
          <Reveal client:visible variant="fade-up" delay={0.06}>
            <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${post.categoryPalette}`}>
              {post.category}
            </span>
          </Reveal>

          <Reveal client:visible variant="blur-up" delay={0.12}>
            <h1 class="mt-4 font-display text-3xl font-extrabold leading-[1.1] tracking-tight text-brand-navy sm:text-4xl lg:text-5xl">
              {post.title}
            </h1>
          </Reveal>

          <Reveal client:visible variant="fade-up" delay={0.2}>
            <p class="mt-5 text-base leading-relaxed text-brand-navy/65 sm:text-lg">
              {post.subtitle}
            </p>
          </Reveal>

          <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-brand-navy/55">
            <div class="flex items-center gap-2">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-gradient-to-br from-brand-indigo to-brand-purple font-display text-[10px] font-extrabold text-white shadow-soft">
                {author.initials}
              </span>
              <span class="font-semibold text-brand-navy">{author.name}</span>
            </div>
            <span class="h-4 w-px bg-brand-navy/15"></span>
            <span class="flex items-center gap-1.5">
              <Calendar size={12} strokeWidth={2.5} />
              {post.date}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock size={12} strokeWidth={2.5} />
              {post.readTime}
            </span>
            <span class="ml-auto flex items-center gap-1.5">
              <ShareMenu
                client:load
                url={shareUrl}
                title={post.title}
                position="bottom"
                className="grid h-8 w-8 place-items-center rounded-full border border-brand-navy/10 text-brand-navy/60 transition-colors hover:bg-brand-navy/[0.04]"
              />
              <button type="button" class="grid h-8 w-8 place-items-center rounded-full border border-brand-navy/10 text-brand-navy/60 hover:bg-brand-navy/[0.04]" aria-label="Save">
                <Bookmark size={13} strokeWidth={2.5} />
              </button>
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* FEATURED IMAGE */}
    <section class="relative pt-6 pb-14 sm:pt-10 sm:pb-20">
      <div class="container">
        <Reveal client:visible variant="scale">
          <div class="relative aspect-[16/9] overflow-hidden rounded-[28px] border border-brand-navy/10 shadow-float">
            <img
              src={post.image}
              alt={post.title}
              class="h-full w-full object-cover"
              draggable="false"
              loading="eager"
              fetchpriority="high"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-brand-navy/25 via-transparent to-transparent"></div>
          </div>
        </Reveal>
      </div>
    </section>

    {/* ARTICLE + SIDEBAR */}
    <section class="relative pb-16 sm:pb-24">
      <div class="container">
        <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_300px] md:gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-14">

          <article class="relative prose-oxland">
            <slot />

            {/* Byline footer */}
            <div class="mt-14 flex flex-col items-start justify-between gap-4 rounded-2xl border border-brand-navy/8 bg-brand-navy/[0.02] p-5 sm:flex-row sm:items-center">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-gradient-to-br from-brand-indigo to-brand-purple font-display text-[11px] font-extrabold text-white shadow-soft">
                  {author.initials}
                </span>
                <div>
                  <div class="text-sm font-bold text-brand-navy">Written by {author.name}</div>
                  <div class="text-[11px] text-brand-navy/55">{author.role}</div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] font-semibold text-brand-navy/55">Share this piece</span>
                <ShareMenu
                  client:load
                  url={shareUrl}
                  title={post.title}
                  position="top"
                  className="grid h-8 w-8 place-items-center rounded-full border border-brand-navy/10 bg-white text-brand-navy/60 transition-colors hover:bg-brand-navy/[0.04]"
                />
              </div>
            </div>
          </article>

          {/* SIDEBAR */}
          <div class="md:sticky md:top-24 md:self-start">
            <BlogSidebar client:load author={author} />
          </div>

        </div>
      </div>
    </section>

    {/* RELATED POSTS — interlinking for SEO */}
    {related.length > 0 && (
      <section class="relative py-16 sm:py-20 bg-[#f7f8fd]/50">
        <div class="container">
          <Reveal client:visible variant="fade-up">
            <div class="mx-auto max-w-2xl text-center">
              <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
                Read next
              </div>
              <h2 class="mt-4 font-display text-3xl font-extrabold text-brand-navy sm:text-4xl">
                More from{" "}
                <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">the Oxland archive.</span>
              </h2>
            </div>
          </Reveal>

          <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
            {related.map((p, i) => (
              <Reveal client:visible delay={i * 0.08}>
                <a
                  href={p.href}
                  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-brand-navy/10 bg-white shadow-card transition-all hover:-translate-y-1 hover:shadow-float"
                >
                  <div class="relative aspect-[16/9] overflow-hidden">
                    <img
                      src={p.image}
                      alt={p.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      draggable="false"
                      loading="lazy"
                    />
                    <div class="absolute left-3 top-3 inline-flex items-center rounded-full bg-white/95 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-brand-indigo shadow-soft">
                      {p.category}
                    </div>
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="font-display text-lg font-extrabold leading-tight text-brand-navy line-clamp-2">
                      {p.title}
                    </h3>
                    <p class="mt-2 text-[13px] leading-relaxed text-brand-navy/60 line-clamp-2">
                      {p.excerpt}
                    </p>
                    <div class="mt-auto pt-4 flex items-center justify-between text-[11px] text-brand-navy/55">
                      <span class="flex items-center gap-1">
                        <Clock size={10} />
                        {p.readTime}
                      </span>
                      <span class="font-bold text-brand-indigo group-hover:underline">
                        Read →
                      </span>
                    </div>
                  </div>
                </a>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>

  {/* JSON-LD structured data for SEO */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style is:global>
  /* Shared prose styles for blog articles */
  .prose-oxland p {
    margin-top: 1.25rem;
    font-size: 16px;
    line-height: 1.75;
    color: rgb(11 20 55 / 0.75);
  }
  .prose-oxland p.lead {
    font-size: 17.5px;
    line-height: 1.75;
    color: rgb(11 20 55 / 0.82);
  }
  .prose-oxland h2 {
    margin-top: 3.5rem;
    font-family: Satoshi, Geist, ui-sans-serif, sans-serif;
    font-size: 26px;
    font-weight: 800;
    color: #0b1437;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  @media (min-width: 640px) {
    .prose-oxland h2 { font-size: 30px; }
  }
  .prose-oxland h3 {
    margin-top: 2rem;
    font-family: Satoshi, Geist, ui-sans-serif, sans-serif;
    font-size: 19px;
    font-weight: 800;
    color: #0b1437;
    line-height: 1.3;
  }
  .prose-oxland a {
    font-weight: 600;
    color: #4f46e5;
    text-decoration: underline;
    text-decoration-color: rgb(79 70 229 / 0.3);
    text-underline-offset: 4px;
  }
  .prose-oxland a:hover { text-decoration-color: #4f46e5; }
  .prose-oxland strong { color: #0b1437; font-weight: 700; }
  .prose-oxland em { color: rgb(11 20 55 / 0.85); }
  .prose-oxland .dropcap::first-letter {
    float: left;
    font-family: Satoshi, sans-serif;
    font-size: 68px;
    font-weight: 800;
    line-height: 1;
    color: #4f46e5;
    margin: 4px 12px 0 0;
    padding: 0;
  }
</style>
