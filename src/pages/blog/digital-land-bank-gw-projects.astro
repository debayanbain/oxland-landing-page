---
import BlogArticleLayout from "@/layouts/BlogArticleLayout.astro";
import {
  Satellite,
  FileText,
  Gavel,
  Map,
  Coins,
  Workflow,
  LayoutDashboard,
  ArrowRight,
  Quote,
} from "lucide-react";

const post = {
  slug: "digital-land-bank-gw-projects",
  category: "Land Management",
  categoryPalette: "bg-brand-indigo/10 text-brand-indigo",
  title: "A Digital Land Bank Built for GW Projects",
  subtitle:
    "Managing land for GW-scale renewable projects takes far more than a parcel list. Here's how OxLand unifies GeoAI, verified records, legal intelligence, valuation and acquisition workflows into one configurable enterprise land bank.",
  date: "27 Jul 2026",
  isoDate: "2026-07-27",
  readTime: "7 min read",
  image: "/blog/A-Digital-Land-Bank-Built-for-GW-Projects.webp",
};

const author = {
  name: "Saheli Bhadra",
  role: "GeoAI & Land Expert · OxLand",
  initials: "SB",
  bio: "Focused on GeoAI and land intelligence at OxLand — turning spatial data into decisions land teams can act on.",
  socials: {},
};

const sections = [
  {
    icon: Satellite,
    chip: "bg-brand-indigo/10 text-brand-indigo",
    dot: "bg-brand-indigo",
    title: "GeoAI-Powered Land Intelligence",
    intro:
      "OxLand leverages geospatial technologies together with AI-assisted analytics to support informed decision-making. Depending on available datasets and project configuration, organizations can monitor land changes, analyze parcel boundaries, visualize GIS layers, and review satellite or drone-derived insights.",
    items: [
      "AI-assisted land parcel analysis",
      "Satellite-based change detection",
      "Encroachment monitoring",
      "Boundary verification support",
      "Infrastructure proximity analysis",
      "Project progress monitoring",
      "Multi-layer GIS visualization",
    ],
  },
  {
    icon: FileText,
    chip: "bg-brand-blue/10 text-brand-blue",
    dot: "bg-brand-blue",
    title: "Verified Land Records Management",
    intro:
      "OxLand provides a centralized repository for land-related documents. Organizations can securely store, index, search, and retrieve records while maintaining document traceability. Availability of records depends on the relevant government authority and client-provided data.",
    items: [
      "Record of Rights (RoR)",
      "7/12 Extract",
      "Jamabandi",
      "Khatian",
      "Mutation Records",
      "Survey Records",
      "Cadastral Maps",
      "Registered Sale Deeds",
      "Registration Documents",
      "Revenue Records",
      "Encumbrance Certificates",
      "Possession Documents",
    ],
  },
  {
    icon: Gavel,
    chip: "bg-brand-purple/10 text-brand-purple",
    dot: "bg-brand-purple",
    title: "Legal & Court Case Management",
    intro:
      "Where legally permissible and data is available, OxLand can assist organizations in organizing and monitoring litigation-related information associated with land parcels.",
    note: "OxLand is an information-management tool and does not provide legal advice.",
    items: [
      "Court case repository",
      "Litigation tracking",
      "Hearing schedule management",
      "Case status monitoring",
      "Legal document repository",
      "Advocate assignment records",
      "Notice management",
      "Parcel-wise litigation history",
    ],
  },
  {
    icon: Map,
    chip: "bg-emerald-50 text-emerald-600",
    dot: "bg-emerald-500",
    title: "Land Use Pattern Analysis",
    intro:
      "OxLand integrates GIS and remote-sensing datasets to help visualize existing land-use patterns and support planning decisions.",
    note: "Final suitability assessments should always consider applicable regulations and field verification.",
    items: [
      "Agricultural land",
      "Forest areas",
      "Barren land",
      "Industrial zones",
      "Residential areas",
      "Water bodies",
      "Government land",
      "Wasteland",
      "Protected areas",
    ],
  },
  {
    icon: Coins,
    chip: "bg-amber-50 text-amber-600",
    dot: "bg-amber-500",
    title: "Intelligent Land Valuation Support",
    intro:
      "OxLand provides analytical tools to support land valuation by organizing available datasets and indicators.",
    note: "It does not determine or guarantee market value or statutory valuation.",
    items: [
      "Circle rate references",
      "Market value inputs",
      "Road connectivity",
      "Nearby infrastructure",
      "Industrial influence",
      "Land-use category",
      "Comparable transaction records",
      "Accessibility",
      "Acquisition status",
    ],
  },
  {
    icon: Workflow,
    chip: "bg-rose-50 text-rose-600",
    dot: "bg-rose-500",
    title: "Integrated Land Acquisition Workflow",
    intro:
      "OxLand digitizes acquisition workflows, providing visibility and auditability across the entire project lifecycle.",
    items: [
      "Land identification",
      "Parcel shortlisting",
      "Owner verification",
      "Due diligence",
      "Document collection",
      "Land record verification",
      "Legal clearance",
      "Negotiation",
      "Compensation tracking",
      "Registration",
      "Mutation",
      "Possession",
      "Handover",
      "Project monitoring",
    ],
  },
  {
    icon: LayoutDashboard,
    chip: "bg-teal-50 text-teal-600",
    dot: "bg-teal-500",
    title: "Executive Dashboard & Decision Intelligence",
    intro:
      "Role-based dashboards provide operational visibility to support project monitoring and decision-making.",
    items: [
      "Land bank summary",
      "Project-wise acquisition status",
      "Village & district progress",
      "Pending approvals",
      "Litigation overview",
      "Verified vs. pending records",
      "Compensation status",
      "GIS dashboard",
      "Timeline tracking",
      "Risk indicators",
      "Team productivity",
    ],
  },
];

const related = [
  {
    href: "/blog/biggest-challenge-in-infrastructure",
    title: "The Biggest Challenge in Infrastructure Isn't Construction. It's Land.",
    category: "Land Management",
    excerpt: "Land acquisition and fragmented land information quietly drive most infrastructure delays in India.",
    image: "/blog/Biggest-Challenge-in-Infrastructure.webp",
    readTime: "4 min read",
  },
  {
    href: "/blog/land-acquisition-row",
    title: "Land Acquisition & ROW for Linear Projects: Start Right with OxLand",
    category: "Land Management",
    excerpt: "The nine pillars of a successful ROW acquisition — and the monitoring that saves millions.",
    image: "/blog/Land-Acquisition-%26-ROW.png",
    readTime: "6 min read",
  },
  {
    href: "/blog/land-acquisition-india-complex",
    title: "Why Land Acquisition in India is Complex — And How OxLand Simplifies It",
    category: "Land Acquisition",
    excerpt: "India's land data is scattered across formats, languages and authorities. Here's why that fragmentation costs months.",
    image: "/blog/Land-Acquisition-in-India.png",
    readTime: "5 min read",
  },
];
---
<BlogArticleLayout {post} {author} {related}>

  <p class="lead dropcap">
    Managing land for GW-scale renewable energy projects requires more than maintaining a list of parcels. It demands a unified platform that combines geospatial intelligence, verified land records, legal intelligence, land-use insights, valuation support, and workflow management. <strong>OxLand</strong> is designed to bring these capabilities together within a centralized enterprise platform.
  </p>

  <p style="margin-top:0.75rem;font-size:13px;">
    <em class="text-brand-navy/50">Features and capabilities may be configured based on project scope, client requirements, and applicable laws and data availability.</em>
  </p>

  {sections.map((s) => (
    <div>
      <div class="mt-14 flex items-center gap-3">
        <span class={`grid h-11 w-11 shrink-0 place-items-center rounded-xl ${s.chip}`}>
          <s.icon size={20} strokeWidth={2.25} />
        </span>
        <h2 style="margin-top:0;">{s.title}</h2>
      </div>

      <p>{s.intro}</p>
      {s.note && (
        <p style="margin-top:0.5rem;font-size:13px;">
          <em class="text-brand-navy/50">{s.note}</em>
        </p>
      )}

      <div class="mt-5 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {s.items.map((it) => (
          <div class="flex items-center gap-2 rounded-lg border border-brand-navy/10 bg-white px-3 py-2 text-[13px] font-medium text-brand-navy/80 shadow-[0_1px_0_rgba(255,255,255,0.6)_inset,0_6px_18px_-16px_rgba(11,20,55,0.3)]">
            <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${s.dot}`}></span>
            <span>{it}</span>
          </div>
        ))}
      </div>
    </div>
  ))}

  {/* Pull quote */}
  <div class="relative my-12 rounded-3xl border border-brand-indigo/15 bg-gradient-to-br from-brand-indigo/5 via-white to-brand-purple/5 p-8">
    <Quote size={26} strokeWidth={2.5} class="text-brand-indigo/40" />
    <p class="mt-3 font-display text-xl font-bold leading-snug text-brand-navy sm:text-2xl">
      One configurable land bank —{" "}
      <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">
        GeoAI, verified records, litigation, valuation and acquisition, aligned to your project and your data.
      </span>
    </p>
  </div>

  {/* Inline CTA */}
  <div class="mt-10 rounded-3xl border border-brand-indigo/20 bg-gradient-to-br from-brand-indigo/[0.04] via-white to-brand-purple/[0.04] p-6 sm:p-8">
    <p style="margin-top:0;font-size:15px;color:#0b1437;font-weight:600;">
      Planning a GW-scale renewable rollout?
    </p>
    <p style="margin-top:0.5rem;font-size:14px;">
      Share your project footprint and data sources — we'll show you how OxLand configures a land bank around it: GeoAI layers, records, litigation, valuation and the full acquisition workflow.
    </p>
    <a href="/contact" class="mt-5 inline-flex items-center gap-2 rounded-full bg-brand-gradient px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-float" style="text-decoration:none;color:white;">
      Book a walkthrough on your project
      <ArrowRight size={14} strokeWidth={2.5} />
    </a>
  </div>

</BlogArticleLayout>
