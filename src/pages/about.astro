---
import Layout from "@/layouts/Layout.astro";
import Reveal from "@/components/Reveal.tsx";
import { ArrowRight, Compass, Layers3, ShieldCheck, HeartHandshake, Sparkles, Building2 } from "lucide-react";

const values = [
  {
    icon: Compass,
    title: "Truth beats theatre",
    description: "One parcel record is the source of truth. No parallel spreadsheets, no side-of-desk trackers.",
    palette: "text-emerald-600 bg-emerald-50",
  },
  {
    icon: Layers3,
    title: "Depth over demos",
    description: "Cadastre, litigation and field-ops realism first. Pretty UI second. We ship things that hold up in a court, not a pitch.",
    palette: "text-brand-indigo bg-brand-indigo/10",
  },
  {
    icon: ShieldCheck,
    title: "Compliance is a feature",
    description: "DPDP, SOC 2, ISO 27001, MeitY, GeM — every guardrail our customers need, on day one.",
    palette: "text-brand-purple bg-brand-purple/10",
  },
  {
    icon: HeartHandshake,
    title: "Field teams are the customer",
    description: "The surveyor in Sehore, the counsel in Nagpur, the AGM in Bhopal. Products built for them tend to work.",
    palette: "text-rose-600 bg-rose-50",
  },
];

const stats = [
  { value: "1.2M+", label: "parcels under management" },
  { value: "14", label: "PSUs · 32 developers" },
  { value: "18", label: "states + 4 UTs" },
  { value: "62%", label: "faster cycles" },
];
---

<Layout
  title="About Us — Oxland | The team building India's land-ops OS"
  description="About Oxland — the team building the operating system for modern land acquisition, GIS, litigation and R&R teams in India. Our story, values and stats."
>
  <main class="relative">

    {/* -------------------- HERO -------------------- */}
    <section class="relative isolate overflow-hidden pt-32 pb-16 sm:pt-40 sm:pb-20">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-grid-faint [background-size:42px_42px] opacity-40"></div>
        <div
          class="absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(closest-side, rgba(79,70,229,0.32), rgba(124,58,237,0.18) 50%, transparent 75%);"
        ></div>
        <img src="/cloud1.png" alt="" aria-hidden="true" class="absolute -top-4 left-[5%] w-[280px] opacity-65 blur-[2px] select-none" />
        <img src="/cloud2.png" alt="" aria-hidden="true" class="absolute top-32 right-[3%] w-[260px] opacity-55 blur-[1.5px] select-none" />
      </div>

      <div class="container relative">
        <div class="mx-auto max-w-3xl text-center">
          <Reveal client:visible variant="blur-up">
            <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-indigo animate-pulse-soft"></span>
              About Us
            </div>
          </Reveal>

          <Reveal client:visible variant="blur-up" delay={0.08}>
            <h1 class="mt-6 font-display text-5xl font-extrabold leading-[1.05] tracking-tight text-brand-navy sm:text-6xl">
              We build the workspace{" "}
              <span class="bg-gradient-to-r from-brand-blue via-brand-indigo to-brand-purple bg-clip-text text-transparent">
                Indian land teams deserve.
              </span>
            </h1>
          </Reveal>

          <Reveal client:visible variant="fade-up" delay={0.16}>
            <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-brand-navy/65 sm:text-lg">
              A small team from Bengaluru, Mumbai and Delhi obsessed with one problem: helping the people who actually acquire, manage and defend land in India do it with less friction, more truth and a real audit trail.
            </p>
          </Reveal>
        </div>

        {/* Stats strip */}
        <Reveal client:visible variant="fade-up" delay={0.28}>
          <div class="mx-auto mt-14 max-w-4xl overflow-hidden rounded-3xl border border-brand-navy/10 bg-white/80 backdrop-blur-md shadow-card">
            <div class="grid grid-cols-2 divide-x divide-brand-navy/8 lg:grid-cols-4">
              {stats.map((s, i) => (
                <div class={`px-5 py-6 text-center ${i >= 2 ? "border-t border-brand-navy/8 lg:border-t-0" : ""}`}>
                  <div class="font-display text-3xl font-extrabold tracking-tight bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent tabular-nums sm:text-4xl">
                    {s.value}
                  </div>
                  <div class="mt-1 text-xs font-semibold text-brand-navy/60">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </Reveal>
      </div>
    </section>

    {/* -------------------- WHY WE BUILT IT -------------------- */}
    <section class="relative py-14 sm:py-20">
      <div class="container">
        <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
          <Reveal client:visible variant="slide-right">
            <div>
              <div class="inline-flex items-center gap-2 rounded-full border border-brand-purple/20 bg-brand-purple/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-purple">
                <Sparkles size={11} strokeWidth={2.5} />
                Why we built Oxland
              </div>
              <h2 class="mt-4 font-display text-3xl font-extrabold leading-tight tracking-tight text-brand-navy sm:text-4xl">
                Because a spreadsheet can't{" "}
                <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">
                  hold up a corridor.
                </span>
              </h2>
            </div>
          </Reveal>

          <Reveal client:visible variant="slide-left" delay={0.08}>
            <div class="space-y-4 text-[15px] leading-relaxed text-brand-navy/70">
              <p>
                Every serious land project in India runs on the same broken stack: four spreadsheets, a legacy GIS install, two case-tracking tools, a WhatsApp group and a folder of scanned PDFs. Timelines slip. Audits are painful. Truth lives in five places.
              </p>
              <p>
                We started Oxland in 2024 because our own teams had felt it — running acquisitions where the map, the ownership chain and the litigation case were three different objects that had to be reconciled by hand. That reconciliation is the invisible tax on every project.
              </p>
              <p class="text-brand-navy/85 font-medium">
                Oxland removes it. One parcel record, every workflow attached, every action versioned. That's the whole thesis.
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    {/* -------------------- VALUES -------------------- */}
    <section class="relative bg-[#f7f8fd]/50 py-14 sm:py-20">
      <div class="container">
        <Reveal client:visible>
          <div class="mx-auto max-w-3xl text-center">
            <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
              <Building2 size={11} strokeWidth={2.5} />
              What we believe
            </div>
            <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-brand-navy sm:text-4xl">
              Four principles.{" "}
              <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">
                No exceptions.
              </span>
            </h2>
          </div>
        </Reveal>

        <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {values.map((v, i) => (
            <Reveal client:visible delay={i * 0.06}>
              <article class="h-full rounded-2xl border border-brand-navy/10 bg-white p-5 shadow-card transition-all hover:-translate-y-0.5 hover:shadow-float">
                <span class={`grid h-10 w-10 place-items-center rounded-xl ${v.palette}`}>
                  <v.icon size={18} strokeWidth={2.25} />
                </span>
                <h3 class="mt-4 font-display text-base font-extrabold text-brand-navy leading-tight">
                  {v.title}
                </h3>
                <p class="mt-2 text-[13px] leading-relaxed text-brand-navy/60">
                  {v.description}
                </p>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    {/* -------------------- CLOSING CTA -------------------- */}
    <section class="relative py-14 sm:py-20">
      <div class="container">
        <Reveal client:visible variant="scale">
          <div class="relative overflow-hidden rounded-[32px] bg-brand-navy">
            <div class="pointer-events-none absolute inset-0">
              <div class="absolute -top-24 -left-16 h-72 w-72 rounded-full blur-3xl opacity-55" style="background: radial-gradient(closest-side, rgba(79,70,229,0.55), transparent 70%);"></div>
              <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full blur-3xl opacity-50" style="background: radial-gradient(closest-side, rgba(124,58,237,0.55), transparent 70%);"></div>
              <div class="absolute inset-0 opacity-[0.06]" style="background-image: linear-gradient(to right, rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 44px 44px;"></div>
            </div>

            <div class="relative flex flex-col items-center justify-between gap-6 px-8 py-10 text-center sm:flex-row sm:text-left sm:px-12">
              <div>
                <div class="text-[10px] font-bold uppercase tracking-widest text-brand-lavender">
                  Work with us
                </div>
                <h3 class="mt-2 font-display text-2xl font-extrabold text-white sm:text-3xl">
                  Want to help build{" "}
                  <span class="bg-gradient-to-r from-brand-lavender via-white to-brand-lavender bg-clip-text text-transparent">
                    India's land-ops OS?
                  </span>
                </h3>
                <p class="mt-2 max-w-md text-sm text-white/70">
                  We're hiring engineers, GIS specialists, land-ops leads and a founding designer. Reach out — every message goes to a human.
                </p>
              </div>
              <a
                href="/contact"
                class="group inline-flex shrink-0 items-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-navy shadow-soft transition-all hover:bg-white/90"
              >
                Get in touch
                <ArrowRight size={14} strokeWidth={2.5} class="transition-transform group-hover:translate-x-0.5" />
              </a>
            </div>
          </div>
        </Reveal>
      </div>
    </section>

  </main>
</Layout>
