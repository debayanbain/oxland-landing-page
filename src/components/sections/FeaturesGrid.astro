</style>

<script>
  // ── Cloud mouse parallax (composes with CSS drift via `translate` property) ──
  (function () {
    const section = document.getElementById("features");
    if (!section) return;

    const clouds = ["cloud-1", "cloud-2", "cloud-3"]
      .map((id) => {
        const el = document.getElementById(id);
        return el
          ? {
              el,
              depth: parseFloat((el as HTMLElement).dataset.depth ?? "0.4"),
            }
          : null;
      })
      .filter((c): c is { el: HTMLElement; depth: number } => c !== null);

    let tx = 0,
      ty = 0,
      cx = 0,
      cy = 0;

    section.addEventListener("mousemove", (e) => {
      const r = section.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 38;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 20;
    });
    section.addEventListener("mouseleave", () => {
      tx = 0;
      ty = 0;
    });

    (function tick() {
      cx += (tx - cx) * 0.055;
      cy += (ty - cy) * 0.055;
      clouds.forEach(({ el, depth }) => {
        el.style.translate = `${(cx * depth).toFixed(2)}px ${(cy * depth).toFixed(2)}px`;
      });
      requestAnimationFrame(tick);
    })();
  })();

  // ── Stat card: counter + chart draw animation ────────────────────────
  (function () {
    const card = document.getElementById("stat-card");
    const countEl = document.getElementById("parcels-count");
    const strokeEl = document.getElementById("parcels-stroke");
    const fillEl = document.getElementById("parcels-fill");
    const dotEl = document.getElementById("parcels-dot");
    if (!card || !countEl || !strokeEl) return;

    // Prime SVG state (hidden before animation)
    const pathLen = (strokeEl as unknown as SVGPathElement).getTotalLength();
    strokeEl.style.strokeDasharray = String(pathLen);
    strokeEl.style.strokeDashoffset = String(pathLen);
    if (fillEl) fillEl.style.opacity = "0";
    if (dotEl) {
      dotEl.style.opacity = "0";
      dotEl.style.transform = "scale(0)";
      dotEl.style.transformOrigin = "208px 28px";
    }

    let fired = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting || fired) return;
        fired = true;
        io.disconnect();

        // 1. Count-up: 0 → 87,000 over 1.8 s with ease-out cubic
        const TARGET = 87000,
          DUR = 1800;
        const t0 = performance.now();
        function easeOut(t: number) {
          return 1 - Math.pow(1 - t, 3);
        }
        (function countUp(now: number) {
          const p = Math.min((now - t0) / DUR, 1);
          countEl.textContent = Math.round(
            easeOut(p) * TARGET,
          ).toLocaleString();
          if (p < 1) requestAnimationFrame(countUp);
        })(t0);

        // 2. Stroke draw over 1.4 s
        requestAnimationFrame(() => {
          strokeEl.style.transition =
            "stroke-dashoffset 1.4s cubic-bezier(0.4,0,0.2,1)";
          strokeEl.style.strokeDashoffset = "0";
        });

        // 3. Fill fade in
        setTimeout(() => {
          if (fillEl) {
            fillEl.style.transition = "opacity 0.9s ease";
            fillEl.style.opacity = "1";
          }
        }, 320);

        // 4. Dot spring-pop at end of stroke draw
        setTimeout(() => {
          if (dotEl) {
            dotEl.style.transition =
              "opacity 0.2s ease, transform 0.45s cubic-bezier(0.34,1.56,0.64,1)";
            dotEl.style.opacity = "1";
            dotEl.style.transform = "scale(1)";
          }
        }, 1280);
      },
      { threshold: 0.55 },
    );

    io.observe(card);
  })();
</script>
