---
import Reveal from "@/components/Reveal.tsx";
import { Quote, Star, Building2 } from "lucide-react";

const badges = [
  "ISO 27001",
  "SOC 2 Type II",
  "DPDP Act 2023",
  "MeitY empanelled",
  "ISMS audited",
];
---

<section class="relative py-16 sm:py-24">
  <div class="container">
    <Reveal client:visible variant="scale">
      <div class="relative overflow-hidden rounded-[36px] border border-brand-navy/8 bg-white shadow-card">
        {/* Decorative */}
        <div
          class="pointer-events-none absolute -top-40 -right-40 h-[420px] w-[420px] rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(closest-side, rgba(124,58,237,0.35), transparent 70%);"
        ></div>
        <div
          class="pointer-events-none absolute -bottom-40 -left-40 h-[380px] w-[380px] rounded-full opacity-50 blur-3xl"
          style="background: radial-gradient(closest-side, rgba(47,91,255,0.3), transparent 70%);"
        ></div>
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.04]"
          style="background-image: radial-gradient(circle, #6366f1 1px, transparent 1px); background-size: 22px 22px;"
        ></div>

        <div class="relative grid items-center gap-12 px-8 py-14 lg:grid-cols-[1.4fr_1fr] lg:px-16 lg:py-20">
          <div>
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-brand-indigo to-brand-purple text-white shadow-float">
              <Quote size={24} strokeWidth={2.25} />
            </span>

            <p class="mt-7 font-display text-2xl font-bold leading-snug text-brand-navy sm:text-3xl lg:text-4xl">
              "We retired four spreadsheets, a legacy GIS install and two case-tracking tools in the first quarter. Our acquisition timeline on the Phase-2 corridor moved from{" "}
              <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">
                18 months to 11 months
              </span>{" "}
              — and the audit trail is finally something we can hand to the ministry without a panic."
            </p>

            <div class="mt-8 flex items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-brand-indigo/10 text-brand-indigo font-display font-extrabold text-lg ring-2 ring-white shadow-soft">
                RS
              </div>
              <div>
                <p class="font-display text-base font-extrabold text-brand-navy">Rohan Sharma</p>
                <p class="text-sm text-brand-navy/60">Project Director, Land Acquisition · National Highways Infra-Tech Partner</p>
              </div>
            </div>

            <div class="mt-5 flex items-center gap-1.5">
              {Array.from({ length: 5 }).map(() => (
                <Star size={16} class="fill-brand-indigo text-brand-indigo" />
              ))}
              <span class="ml-2 text-xs font-semibold text-brand-navy/55">5.0 · verified customer</span>
            </div>
          </div>

          {/* Trust badges column */}
          <div class="lg:pl-8 lg:border-l lg:border-brand-navy/8">
            <p class="text-xs font-bold uppercase tracking-widest text-brand-navy/45">Compliance & trust</p>
            <p class="mt-3 text-sm leading-relaxed text-brand-navy/65">
              Built for the security & data residency requirements of Indian PSUs, infrastructure developers and state nodal agencies.
            </p>

            <div class="mt-6 flex flex-wrap gap-2">
              {badges.map((b) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-navy/10 bg-white px-3 py-1.5 text-xs font-semibold text-brand-navy/75 shadow-[0_1px_0_rgba(255,255,255,0.6)_inset,0_2px_6px_-2px_rgba(11,20,55,0.08)]">
                  <span class="h-1.5 w-1.5 rounded-full bg-brand-indigo"></span>
                  {b}
                </span>
              ))}
            </div>

            <div class="mt-7 rounded-2xl bg-gradient-to-br from-brand-indigo/8 to-brand-purple/8 p-5">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-indigo">
                <Building2 size={14} />
                Trusted by
              </div>
              <p class="mt-2 font-display text-2xl font-extrabold text-brand-navy">
                14 PSUs · 32 infra developers · 6 state agencies
              </p>
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
