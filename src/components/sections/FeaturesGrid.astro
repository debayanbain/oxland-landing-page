---
import Reveal, { RevealGroup, RevealItem } from "@/components/Reveal.tsx";
import Icon from "@/components/Icon.astro";

const features = [
  {
    icon: "map-pinned",
    title: "GIS Based Land Mapping",
    desc: "Visualize, track and manage land parcels with interactive GIS maps and layers.",
    tint: "#16A34A",
    bg: "#E8F6EC",
  },
  {
    icon: "file-text",
    title: "Digital Land Records",
    desc: "Store, organize and manage all land related documents in a secure digital repository.",
    tint: "#2563EB",
    bg: "#E8F0FE",
  },
  {
    icon: "user-check",
    title: "Ownership Management",
    desc: "Track ownership details, history, and transfers with complete transparency.",
    tint: "#7C3AED",
    bg: "#F2ECFE",
  },
  {
    icon: "clipboard",
    title: "Land Acquisition Management",
    desc: "Streamline acquisition process, approvals, and compensation management efficiently.",
    tint: "#0D9488",
    bg: "#E0F5F2",
  },
  {
    icon: "land-plot",
    title: "Survey & Demarcation Management",
    desc: "Manage surveys, demarcation data, and boundary details accurately.",
    tint: "#E11D48",
    bg: "#FDECEF",
  },
  {
    icon: "file-pen",
    title: "Document Workflow & Approvals",
    desc: "Automate document verification, approvals and workflow processes seamlessly.",
    tint: "#DB2777",
    bg: "#FCE9F4",
  },
  {
    icon: "bell",
    title: "Alerts & Notifications",
    desc: "Get real-time alerts for important updates, tasks, deadlines and approvals.",
    tint: "#059669",
    bg: "#E7F6F0",
  },
  {
    icon: "lock",
    title: "Role Based Access Control",
    desc: "Secure your data with role-based access and permission management.",
    tint: "#8B5CF6",
    bg: "#F2ECFE",
  },
];
---

<section
  id="features"
  class="relative overflow-hidden bg-[#FAF7F0] py-20 sm:py-24 scroll-mt-16"
>
  {/* faint decorative dot grids */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-10 top-24 hidden h-24 w-24 bg-[radial-gradient(circle,rgba(11,20,55,0.14)_1.5px,transparent_1.5px)] [background-size:11px_11px] lg:block"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-20 left-8 hidden h-24 w-24 bg-[radial-gradient(circle,rgba(11,20,55,0.12)_1.5px,transparent_1.5px)] [background-size:11px_11px] lg:block"
  >
  </div>

  {/* bottom fade to white background */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 inset-x-0 h-24 bg-gradient-to-b from-transparent to-white/60"
  >
  </div>

  <div class="container">
    {/* heading */}
    <Reveal client:visible className="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-success/20 bg-success/10 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-[#15803D]"
      >
        <Icon name="sparkles" size={14} />
        Our Features
      </span>
      <h2
        class="mt-5 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-brand-navy sm:text-5xl"
      >
        Powerful Features for<br />Smart Land Management
      </h2>
      <div
        class="mt-5 flex items-center justify-center gap-2"
        aria-hidden="true"
      >
        <span class="h-px w-8 bg-brand-navy/25"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
        <span class="h-1.5 w-1.5 rounded-full bg-brand-navy/30"></span>
        <span class="h-px w-8 bg-brand-navy/25"></span>
      </div>
      <p class="mx-auto mt-4 max-w-md text-base text-brand-navy/60 sm:text-lg">
        Explore powerful capabilities designed to simplify workflows and boost
        team productivity.
      </p>
    </Reveal>

    <div
      class="mt-14 grid items-stretch gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12"
    >
      {/* feature cards */}
      <RevealGroup
        client:visible
        stagger={0.07}
        className="grid content-start gap-4 sm:grid-cols-2 xl:grid-cols-4"
      >
        {
          features.map((f) => (
            <RevealItem variant="blur-up" y={22}>
              <div
                class="group feature-card flex h-full flex-col rounded-2xl border border-[#EDE9DF] bg-white p-5 shadow-card
                will-change-transform
                hover:-translate-y-2
                hover:shadow-float
                hover:border-white/60"
              >
                <span
                  class="icon-container grid h-11 w-11 place-items-center rounded-xl
                  group-hover:scale-110"
                  style={{ background: f.bg, color: f.tint }}
                >
                  <Icon name={f.icon} size={20} />
                </span>
                <h3 class="mt-4 font-display text-[15px] font-bold leading-snug text-brand-navy">
                  {f.title}
                </h3>
                <span
                  class="indicator-line mt-2 h-[3px] w-7 rounded-full
                  group-hover:w-12"
                  style={{ background: f.tint }}
                  aria-hidden="true"
                />
                <p class="mb-4 mt-2.5 text-xs leading-relaxed text-brand-navy/55">
                  {f.desc}
                </p>
                <span
                  class="arrow-btn mt-auto grid h-8 w-8 shrink-0 place-items-center self-end rounded-full
                  border border-success/40 text-success bg-transparent
                  group-hover:scale-110
                  group-hover:bg-success
                  group-hover:text-white
                  group-hover:border-success"
                  aria-hidden="true"
                >
                  <Icon name="arrow" size={14} />
                </span>
              </div>
            </RevealItem>
          ))
        }
      </RevealGroup>

      {/* visual column */}
      <Reveal
        client:visible
        delay={0.15}
        variant="slide-right"
        className="relative mx-auto w-full max-w-xl lg:max-w-none lg:flex lg:flex-col lg:justify-center lg:pt-8"
      >
        {/* ── Cloud 1 — large, top-left ────────────────────────────────── */}
        <div
          id="cloud-1"
          data-depth="0.4"
          aria-hidden="true"
          class="pointer-events-none absolute -left-4 top-16 z-10 animate-cloud-1"
        >
          <svg
            viewBox="0 0 256 256"
            class="h-24 w-24 text-slate-400/35"
            fill="none"
            style="filter:drop-shadow(0 4px 10px rgba(0,0,0,0.05))"
          >
            <g transform="translate(-362.5464,-406.21469)">
              <path
                d="m 465.83684,466.9869 c -18.8823,0 -37.6499,7.7751 -51.0017,21.127 -8.4122,8.4121 -14.6043,18.9734 -18.0383,30.3583 -8.2539,1.5581 -16.0492,5.5866 -21.9931,11.5304 -7.7473,7.7473 -12.2573,18.6331 -12.2573,29.5895 0,10.9565 4.51,21.8458 12.2573,29.5931 7.7474,7.7473 18.6367,12.2573 29.5931,12.2573 l 187.4365,0 c 6.9935,0 13.9453,-2.8775 18.8904,-7.8224 4.9452,-4.9451 7.8227,-11.8971 7.8227,-18.8906 0,-6.9935 -2.8775,-13.9417 -7.8227,-18.8868 -4.9147,-4.9149 -11.8119,-7.784 -18.7617,-7.8193 -1.3562,-12.6709 -7.0967,-24.867 -16.1148,-33.8851 -10.3847,-10.3847 -24.9798,-16.4314 -39.666,-16.4314 -3.5656,0 -7.1233,0.3656 -10.6192,1.0539 -2.5582,-3.8175 -5.4715,-7.3951 -8.7235,-10.6469 -13.3518,-13.3519 -32.1193,-21.127 -51.0017,-21.127 z"
                fill="currentColor"></path>
            </g>
          </svg>
        </div>

        {/* ── Cloud 2 — small, right side ──────────────────────────────── */}
        <div
          id="cloud-2"
          data-depth="0.7"
          aria-hidden="true"
          class="pointer-events-none absolute -right-16 top-24 z-0 animate-cloud-2"
        >
          <svg
            viewBox="0 0 886 677"
            class="h-20 w-24 text-slate-400/40"
            fill="none"
            style="filter:drop-shadow(0 3px 7px rgba(0,0,0,0.05))"
          >
            <path
              d="m 165.5,675.83455 c -20.45306,-2.31082 -42.36559,-8.77757 -62.36929,-18.4062 C 56.02257,634.75318 21.267117,596.90677 7.1978219,552.96372 1.9484874,536.56831 0.57325453,527.33783 0.57325453,508.5 c 0,-25.40919 4.14891767,-43.05246 15.52028447,-66 8.217328,-16.58266 17.145426,-28.74357 32.394499,-44.12435 13.908576,-14.02871 24.289612,-22.23671 39.286917,-31.06309 6.387651,-3.75933 9.191868,-5.95664 8.824312,-6.91447 -0.296322,-0.7722 -1.246695,-5.48421 -2.11194,-10.47113 -11.215653,-64.64246 10.362053,-134.71744 54.646683,-177.46863 18.68058,-18.03372 35.678,-27.94378 57.56653,-33.56317 6.95131,-1.7846 11.52985,-2.25592 21.79946,-2.24409 14.65726,0.0169 25.18026,2.07643 38.10877,7.45859 4.12214,1.71605 7.61266,2.9559 7.7567,2.75522 0.14405,-0.20069 2.23505,-5.76053 4.64668,-12.35521 C 284.74381,118.83623 297.02063,94.298644 306.03464,80.5 333.13486,39.014996 367.1545,11.947106 403.72348,2.773416 415.63843,-0.21556795 441.44468,-0.43645397 453.5,2.3473588 500.74241,13.256568 545.25356,55.615312 572.26017,115.36468 c 2.76823,6.12443 5.16891,11.29958 5.33484,11.50034 0.16594,0.20076 6.06244,-1.24997 13.10334,-3.22386 14.69972,-4.12099 25.45687,-6.16116 40.1576,-7.61617 53.08022,-5.25364 111.64782,11.41088 152.60494,43.42142 10.45631,8.17226 26.63336,25.07064 33.35397,34.84122 27.57174,40.08444 27.85995,88.466 0.76277,128.04548 -2.51769,3.67748 -4.55814,7.01945 -4.53431,7.42661 0.0238,0.40715 3.21572,2.97886 7.09308,5.71489 15.55186,10.97406 31.49642,28.20075 42.59986,46.02539 37.97457,60.96159 28.4161,134.6856 -24.24494,187 -21.74681,21.60367 -47.04202,35.50874 -75.80291,41.66974 -14.28648,3.06037 -36.91029,3.04688 -51.42208,-0.0307 -17.42558,-3.69548 -33.9853,-10.53583 -48.54726,-20.05347 -4.27951,-2.79708 -8.10451,-5.06238 -8.5,-5.03401 -0.39549,0.0284 -3.41907,3.93151 -6.71907,8.67364 -6.96459,10.00818 -22.80714,26.94724 -32.95119,35.23183 -22.13056,18.07392 -49.18604,31.22711 -76.39068,37.13781 -15.17158,3.29629 -42.85991,3.76926 -59.06147,1.00888 -47.53154,-8.09832 -90.83592,-36.72314 -119.24389,-78.82193 l -5.02863,-7.45211 -5.72584,8.83515 c -38.64167,59.6254 -112.34987,94.21948 -183.5983,86.1697 z"
              fill="currentColor"></path>
          </svg>
        </div>

        {/* ── Cloud 3 — tiny, lower-left ───────────────────────────────── */}
        <div
          id="cloud-3"
          data-depth="0.25"
          aria-hidden="true"
          class="pointer-events-none absolute -left-2 bottom-64 z-10 animate-cloud-3"
        >
          <svg
            viewBox="0 0 256 256"
            class="h-14 w-14 text-slate-400/35"
            fill="none"
            style="filter:drop-shadow(0 2px 6px rgba(0,0,0,0.05))"
          >
            <g transform="translate(-362.5464,-406.21469)">
              <path
                d="m 465.83684,466.9869 c -18.8823,0 -37.6499,7.7751 -51.0017,21.127 -8.4122,8.4121 -14.6043,18.9734 -18.0383,30.3583 -8.2539,1.5581 -16.0492,5.5866 -21.9931,11.5304 -7.7473,7.7473 -12.2573,18.6331 -12.2573,29.5895 0,10.9565 4.51,21.8458 12.2573,29.5931 7.7474,7.7473 18.6367,12.2573 29.5931,12.2573 l 187.4365,0 c 6.9935,0 13.9453,-2.8775 18.8904,-7.8224 4.9452,-4.9451 7.8227,-11.8971 7.8227,-18.8906 0,-6.9935 -2.8775,-13.9417 -7.8227,-18.8868 -4.9147,-4.9149 -11.8119,-7.784 -18.7617,-7.8193 -1.3562,-12.6709 -7.0967,-24.867 -16.1148,-33.8851 -10.3847,-10.3847 -24.9798,-16.4314 -39.666,-16.4314 -3.5656,0 -7.1233,0.3656 -10.6192,1.0539 -2.5582,-3.8175 -5.4715,-7.3951 -8.7235,-10.6469 -13.3518,-13.3519 -32.1193,-21.127 -51.0017,-21.127 z"
                fill="currentColor"></path>
            </g>
          </svg>
        </div>

        {/* ── Map image — transparent background, drop-shadow ─────────── */}
        <div class="relative">
          {/* ground shadow ellipse */}
          <div
            aria-hidden="true"
            class="absolute -bottom-5 left-1/2 h-10 w-3/4 -translate-x-1/2 rounded-full bg-black/10 blur-2xl"
          >
          </div>

          {/* Dot Grid Top-Right */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-2 top-16 hidden h-16 w-16 bg-[radial-gradient(circle,rgba(11,20,55,0.08)_1.2px,transparent_1.2px)] [background-size:8px_8px] sm:block select-none"
          >
          </div>

          {/* Dot Grid Bottom-Left */}
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -left-6 bottom-24 hidden h-16 w-16 bg-[radial-gradient(circle,rgba(11,20,55,0.08)_1.2px,transparent_1.2px)] [background-size:8px_8px] sm:block select-none"
          >
          </div>

          <div
            class="relative motion-safe:animate-float motion-reduce:animate-none [animation-duration:7s]"
          >
            {
              /* Concentric radar circles centered around the map pin (placed inside floating div to move with the pin) */
            }
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 select-none -z-10 w-[110%] aspect-square"
              style="left: 42%; top: 20%;"
            >
              <svg
                viewBox="0 0 1000 1000"
                class="h-full w-full text-slate-400/40"
                fill="none"
                stroke="currentColor"
              >
                {/* Rotating outer dashed circle */}
                <g
                  class="animate-orbit-reverse"
                  style="transform-origin: 500px 500px;"
                >
                  <circle
                    cx="500"
                    cy="500"
                    r="420"
                    stroke-dasharray="8 8"
                    stroke-width="1.5"></circle>
                </g>
                {/* Rotating middle dashed circle */}
                <g
                  class="animate-orbit-slow"
                  style="transform-origin: 500px 500px;"
                >
                  <circle
                    cx="500"
                    cy="500"
                    r="280"
                    stroke-dasharray="5 5"
                    stroke-width="1.2"></circle>
                </g>
                {/* Stationary inner circle serving as the orbit track */}
                <circle cx="500" cy="500" r="160" stroke-width="1"></circle>

                {/* Orbiting green satellite dot on inner track */}
                <g
                  class="animate-orbit-fast"
                  style="transform-origin: 500px 500px;"
                >
                  <circle cx="500" cy="340" r="8" fill="#16A34A"></circle>
                  <circle
                    cx="500"
                    cy="340"
                    r="8"
                    stroke="#16A34A"
                    stroke-width="1.5"
                    fill="none"
                  >
                    <animate
                      attributeName="r"
                      values="8;28"
                      dur="2.5s"
                      repeatCount="indefinite"></animate>
                    <animate
                      attributeName="opacity"
                      values="1;0"
                      dur="2.5s"
                      repeatCount="indefinite"></animate>
                  </circle>
                </g>

                {/* Orbiting blue satellite dot on outer track */}
                <g
                  class="animate-orbit-reverse"
                  style="transform-origin: 500px 500px;"
                >
                  <circle cx="500" cy="80" r="6" fill="#2F5BFF"></circle>
                  <circle
                    cx="500"
                    cy="80"
                    r="6"
                    stroke="#2F5BFF"
                    stroke-width="1"
                    fill="none"
                  >
                    <animate
                      attributeName="r"
                      values="6;22"
                      dur="3s"
                      repeatCount="indefinite"></animate>
                    <animate
                      attributeName="opacity"
                      values="1;0"
                      dur="3s"
                      repeatCount="indefinite"></animate>
                  </circle>
                </g>
              </svg>
            </div>
            <img
              src="/features.png"
              alt="Isometric 3D map of green land parcels with a location pin"
              width="1536"
              height="1024"
              loading="lazy"
              decoding="async"
              class="w-full [filter:drop-shadow(0_24px_48px_rgba(0,0,0,0.14))_drop-shadow(0_4px_12px_rgba(0,0,0,0.08))]"
            />
          </div>
        </div>

        {/* Total Land Parcels stat card */}
        <div
          id="stat-card"
          class="mt-8 rounded-3xl border border-[#EDE9DF] bg-white p-6 shadow-card sm:p-7"
        >
          <div class="flex items-center gap-5 sm:gap-7">
            <div class="shrink-0">
              <div class="text-sm font-semibold text-brand-navy/70">
                Total Land Parcels
              </div>
              <div
                id="parcels-count"
                class="mt-1 font-display text-4xl font-extrabold tracking-tight text-brand-navy"
              >
                12,568
              </div>
              <div
                class="mt-2 flex items-center gap-1.5 text-sm font-bold text-success"
              >
                <Icon name="trending" size={15} />
                18.6%
                <span class="font-medium text-brand-navy/45">this month</span>
              </div>
            </div>
            <div class="h-20 w-px shrink-0 bg-border" aria-hidden="true"></div>
            <svg
              viewBox="0 0 220 92"
              class="h-24 min-w-0 flex-1"
              aria-hidden="true"
              preserveAspectRatio="none"
            >
              <defs>
                <linearGradient id="parcelsFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#16A34A" stop-opacity="0.22"
                  ></stop>
                  <stop offset="100%" stop-color="#16A34A" stop-opacity="0"
                  ></stop>
                </linearGradient>
              </defs>
              <path
                id="parcels-fill"
                d="M4 74 L32 62 L58 68 L84 48 L110 56 L136 38 L162 46 L188 22 L208 28 L208 92 L4 92 Z"
                fill="url(#parcelsFill)"></path>
              <path
                id="parcels-stroke"
                d="M4 74 L32 62 L58 68 L84 48 L110 56 L136 38 L162 46 L188 22 L208 28"
                fill="none"
                stroke="#16A34A"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
              <circle
                id="parcels-dot"
                cx="208"
                cy="28"
                r="4.5"
                fill="#16A34A"
                stroke="#fff"
                stroke-width="2"></circle>
            </svg>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<style>
  .feature-card {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .icon-container {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .indicator-line {
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .arrow-btn {
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Cloud animations ──────────────────────────────────────────── */
  @keyframes drift-right-slow {
    0% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
    15% {
      transform: translate(8px, -6px) rotate(0.5deg) scale(1.01);
    }
    35% {
      transform: translate(18px, -11px) rotate(1.2deg) scale(1.025);
    }
    50% {
      transform: translate(24px, -8px) rotate(1.5deg) scale(1.03);
    }
    65% {
      transform: translate(20px, -13px) rotate(1deg) scale(1.02);
    }
    80% {
      transform: translate(10px, -5px) rotate(0.4deg) scale(1.01);
    }
    100% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
  }

  @keyframes drift-left-slow {
    0% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
    20% {
      transform: translate(-8px, 3px) rotate(-0.6deg) scale(1.01);
    }
    40% {
      transform: translate(-15px, 7px) rotate(-1.3deg) scale(1.02);
    }
    55% {
      transform: translate(-18px, 4px) rotate(-1.5deg) scale(1.025);
    }
    70% {
      transform: translate(-12px, 8px) rotate(-0.8deg) scale(1.015);
    }
    85% {
      transform: translate(-5px, 3px) rotate(-0.3deg) scale(1.005);
    }
    100% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
  }

  @keyframes drift-right-medium {
    0% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
    25% {
      transform: translate(8px, -5px) rotate(1deg) scale(1.02);
    }
    50% {
      transform: translate(16px, -9px) rotate(2deg) scale(1.04);
    }
    75% {
      transform: translate(9px, -4px) rotate(0.8deg) scale(1.015);
    }
    100% {
      transform: translate(0px, 0px) rotate(0deg) scale(1);
    }
  }

  @keyframes cloud-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.78;
    }
  }

  .animate-cloud-1 {
    animation:
      drift-right-slow 14s ease-in-out infinite,
      cloud-breathe 8s ease-in-out infinite;
  }

  .animate-cloud-2 {
    animation:
      drift-left-slow 16s ease-in-out infinite,
      cloud-breathe 10s 1s ease-in-out infinite;
  }

  .animate-cloud-3 {
    animation:
      drift-right-medium 11s ease-in-out infinite,
      cloud-breathe 6s 2s ease-in-out infinite;
  }

  /* ── Radar/Orbit SVG animations ────────────────────────────────── */
  .animate-orbit-slow {
    transform-origin: 500px 500px;
    animation: rotate-orbit 38s linear infinite;
  }

  .animate-orbit-reverse {
    transform-origin: 500px 500px;
    animation: rotate-orbit-reverse 45s linear infinite;
  }

  .animate-orbit-fast {
    transform-origin: 500px 500px;
    animation: rotate-orbit 16s linear infinite;
  }

  @keyframes rotate-orbit {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rotate-orbit-reverse {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }
</style>

<script>
  // ── Cloud mouse parallax (composes with CSS drift via `translate` property) ──
  (function () {
    const section = document.getElementById("features");
    if (!section) return;

    const clouds = ["cloud-1", "cloud-2", "cloud-3"]
      .map((id) => {
        const el = document.getElementById(id);
        return el
          ? {
              el,
              depth: parseFloat((el as HTMLElement).dataset.depth ?? "0.4"),
            }
          : null;
      })
      .filter((c): c is { el: HTMLElement; depth: number } => c !== null);

    let tx = 0,
      ty = 0,
      cx = 0,
      cy = 0;

    section.addEventListener("mousemove", (e) => {
      const r = section.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width - 0.5) * 38;
      ty = ((e.clientY - r.top) / r.height - 0.5) * 20;
    });
    section.addEventListener("mouseleave", () => {
      tx = 0;
      ty = 0;
    });

    (function tick() {
      cx += (tx - cx) * 0.055;
      cy += (ty - cy) * 0.055;
      clouds.forEach(({ el, depth }) => {
        el.style.translate = `${(cx * depth).toFixed(2)}px ${(cy * depth).toFixed(2)}px`;
      });
      requestAnimationFrame(tick);
    })();
  })();

  // ── Stat card: counter + chart draw animation ────────────────────────
  (function () {
    const card = document.getElementById("stat-card");
    const countEl = document.getElementById("parcels-count");
    const strokeEl = document.getElementById("parcels-stroke");
    const fillEl = document.getElementById("parcels-fill");
    const dotEl = document.getElementById("parcels-dot");
    if (!card || !countEl || !strokeEl) return;

    // Prime SVG state (hidden before animation)
    const pathLen = (strokeEl as unknown as SVGPathElement).getTotalLength();
    strokeEl.style.strokeDasharray = String(pathLen);
    strokeEl.style.strokeDashoffset = String(pathLen);
    if (fillEl) fillEl.style.opacity = "0";
    if (dotEl) {
      dotEl.style.opacity = "0";
      dotEl.style.transform = "scale(0)";
      dotEl.style.transformOrigin = "208px 28px";
    }

    let fired = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting || fired) return;
        fired = true;
        io.disconnect();

        // 1. Count-up: 0 → 12,568 over 1.8 s with ease-out cubic
        const TARGET = 12568,
          DUR = 1800;
        const t0 = performance.now();
        function easeOut(t: number) {
          return 1 - Math.pow(1 - t, 3);
        }
        (function countUp(now: number) {
          const p = Math.min((now - t0) / DUR, 1);
          countEl.textContent = Math.round(
            easeOut(p) * TARGET,
          ).toLocaleString();
          if (p < 1) requestAnimationFrame(countUp);
        })(t0);

        // 2. Stroke draw over 1.4 s
        requestAnimationFrame(() => {
          strokeEl.style.transition =
            "stroke-dashoffset 1.4s cubic-bezier(0.4,0,0.2,1)";
          strokeEl.style.strokeDashoffset = "0";
        });

        // 3. Fill fade in
        setTimeout(() => {
          if (fillEl) {
            fillEl.style.transition = "opacity 0.9s ease";
            fillEl.style.opacity = "1";
          }
        }, 320);

        // 4. Dot spring-pop at end of stroke draw
        setTimeout(() => {
          if (dotEl) {
            dotEl.style.transition =
              "opacity 0.2s ease, transform 0.45s cubic-bezier(0.34,1.56,0.64,1)";
            dotEl.style.opacity = "1";
            dotEl.style.transform = "scale(1)";
          }
        }, 1280);
      },
      { threshold: 0.55 },
    );

    io.observe(card);
  })();
</script>
