---
import Reveal from "@/components/Reveal.tsx";

interface Testimonial {
  rating: number;
  quote: string;
  name: string;
  role: string;
  initials: string;
  from: string;
  to: string;
}

const STAR_PATH =
  "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z";

const featured: Testimonial = {
  rating: 4,
  quote: "This CRM transformed the way our team manages customers and opportunities. Within only three months of consistent use, we achieved a remarkable 35% increase in sales, driven by smarter workflows, better communication, and improved tracking.",
  name: "Alex Jordan",
  role: "Content Strategist",
  initials: "AJ",
  from: "#a78bfa",
  to: "#7c3aed",
};

const col1Bottom: Testimonial = {
  rating: 4,
  quote: "Within just 60 seconds, our complete CRM system was set up and ready for immediate use.",
  name: "Alex Jafer",
  role: "Systems Administrator",
  initials: "AJ",
  from: "#6366f1",
  to: "#4338ca",
};

const col2: Testimonial[] = [
  {
    rating: 4,
    quote: "Our team finally stopped juggling countless spreadsheets and switched to a cleaner, more efficient workflow solution.",
    name: "Daniel Cooper",
    role: "Project Coordinator",
    initials: "DC",
    from: "#38bdf8",
    to: "#0284c7",
  },
  {
    rating: 4,
    quote: "In just one day, our whole team was seamlessly collaborating and managing projects through a single dashboard.",
    name: "Liam Parker",
    role: "Productivity Lead",
    initials: "LP",
    from: "#fbbf24",
    to: "#d97706",
  },
  {
    rating: 4,
    quote: "Our customer response time has improved by 40%, allowing us to provide faster and more efficient support for every client.",
    name: "Ethan Ross",
    role: "Operations Manager",
    initials: "ER",
    from: "#34d399",
    to: "#059669",
  },
];

const col3Top: Testimonial = {
  rating: 4,
  quote: "We moved away from messy manual processes and embraced a smoother workflow that keeps our whole team aligned and efficient.",
  name: "Alison Thomas",
  role: "Team Operations Lead",
  initials: "AT",
  from: "#f472b6",
  to: "#db2777",
};
---

<section id="testimonials" class="relative py-16 sm:py-20">
  <div class="container">

    <!-- Header -->
    <Reveal client:visible>
      <div class="mx-auto max-w-2xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none">
            <rect x="1" y="1" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.6"/>
            <rect x="9" y="1" width="6" height="6" rx="1.5" fill="currentColor"/>
            <rect x="1" y="9" width="6" height="6" rx="1.5" fill="currentColor"/>
            <rect x="9" y="9" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.6"/>
          </svg>
          Testimonials
        </div>
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-5xl">
          Loved by teams, trusted by businesses
        </h2>
        <p class="mt-4 text-base text-brand-navy/60">
          See how Oxland CRM is helping teams work smarter,<br class="hidden sm:block" />
          serve better, and grow faster.
        </p>
      </div>
    </Reveal>

    <!-- 3-column masonry grid -->
    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">

      <!-- ── Col 1: featured tall + short bottom ── -->
      <div class="flex flex-col gap-4">

        <!-- Featured card -->
        <Reveal client:visible delay={0.05}>
          <div class="relative flex flex-1 flex-col overflow-hidden rounded-3xl bg-gradient-to-br from-brand-indigo to-brand-purple p-7 text-white">
            <!-- dot grid -->
            <div
              class="pointer-events-none absolute inset-0 opacity-[0.07]"
              style="background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:18px 18px;"
            />
            <!-- decorative quote -->
            <span class="pointer-events-none absolute right-5 top-3 select-none font-serif text-7xl font-bold leading-none text-white/20">"</span>

            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(s => (
                <svg viewBox="0 0 20 20" fill="currentColor" class={`h-4 w-4 ${s <= featured.rating ? "text-amber-300" : "text-white/25"}`}>
                  <path d={STAR_PATH}/>
                </svg>
              ))}
            </div>

            <p class="relative mt-5 flex-1 text-base font-medium leading-relaxed text-white/90">
              "{featured.quote}"
            </p>

            <div class="mt-8 flex items-center gap-3">
              <div
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white ring-2 ring-white/30"
                style={`background:linear-gradient(135deg,${featured.from},${featured.to})`}
              >
                {featured.initials}
              </div>
              <div>
                <p class="text-sm font-bold text-white">{featured.name}</p>
                <p class="text-xs text-white/60">{featured.role}</p>
              </div>
            </div>
          </div>
        </Reveal>

        <!-- Short bottom card -->
        <Reveal client:visible delay={0.2}>
          <div class="relative overflow-hidden rounded-2xl border border-brand-navy/10 bg-white p-6 shadow-card">
            <span class="pointer-events-none absolute right-4 top-2 select-none font-serif text-6xl font-bold leading-none text-brand-navy/[0.06]">"</span>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(s => (
                <svg viewBox="0 0 20 20" fill="currentColor" class={`h-3.5 w-3.5 ${s <= col1Bottom.rating ? "text-amber-400" : "text-brand-navy/15"}`}>
                  <path d={STAR_PATH}/>
                </svg>
              ))}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-brand-navy/70">"{col1Bottom.quote}"</p>
            <div class="mt-5 flex items-center gap-2.5">
              <div
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
                style={`background:linear-gradient(135deg,${col1Bottom.from},${col1Bottom.to})`}
              >
                {col1Bottom.initials}
              </div>
              <div>
                <p class="text-sm font-semibold text-brand-navy">{col1Bottom.name}</p>
                <p class="text-xs text-brand-navy/50">{col1Bottom.role}</p>
              </div>
            </div>
          </div>
        </Reveal>
      </div>

      <!-- ── Col 2: 3 stacked cards ── -->
      <div class="flex flex-col gap-4">
        {col2.map((t, i) => (
          <Reveal client:visible delay={0.08 + i * 0.07}>
            <div class="relative overflow-hidden rounded-2xl border border-brand-navy/10 bg-white p-6 shadow-card">
              <span class="pointer-events-none absolute right-4 top-2 select-none font-serif text-6xl font-bold leading-none text-brand-navy/[0.06]">"</span>
              <div class="flex gap-0.5">
                {[1,2,3,4,5].map(s => (
                  <svg viewBox="0 0 20 20" fill="currentColor" class={`h-3.5 w-3.5 ${s <= t.rating ? "text-amber-400" : "text-brand-navy/15"}`}>
                    <path d={STAR_PATH}/>
                  </svg>
                ))}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-brand-navy/70">"{t.quote}"</p>
              <div class="mt-5 flex items-center gap-2.5">
                <div
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
                  style={`background:linear-gradient(135deg,${t.from},${t.to})`}
                >
                  {t.initials}
                </div>
                <div>
                  <p class="text-sm font-semibold text-brand-navy">{t.name}</p>
                  <p class="text-xs text-brand-navy/50">{t.role}</p>
                </div>
              </div>
            </div>
          </Reveal>
        ))}
      </div>

      <!-- ── Col 3: top card + highlight card ── -->
      <div class="flex flex-col gap-4">

        <!-- Top regular card -->
        <Reveal client:visible delay={0.12}>
          <div class="relative overflow-hidden rounded-2xl border border-brand-navy/10 bg-white p-6 shadow-card">
            <span class="pointer-events-none absolute right-4 top-2 select-none font-serif text-6xl font-bold leading-none text-brand-navy/[0.06]">"</span>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(s => (
                <svg viewBox="0 0 20 20" fill="currentColor" class={`h-3.5 w-3.5 ${s <= col3Top.rating ? "text-amber-400" : "text-brand-navy/15"}`}>
                  <path d={STAR_PATH}/>
                </svg>
              ))}
            </div>
            <p class="mt-3 text-sm leading-relaxed text-brand-navy/70">"{col3Top.quote}"</p>
            <div class="mt-5 flex items-center gap-2.5">
              <div
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
                style={`background:linear-gradient(135deg,${col3Top.from},${col3Top.to})`}
              >
                {col3Top.initials}
              </div>
              <div>
                <p class="text-sm font-semibold text-brand-navy">{col3Top.name}</p>
                <p class="text-xs text-brand-navy/50">{col3Top.role}</p>
              </div>
            </div>
          </div>
        </Reveal>

        <!-- Highlight / about card -->
        <Reveal client:visible delay={0.22}>
          <div class="relative flex flex-1 flex-col overflow-hidden rounded-2xl border border-brand-indigo/25 bg-gradient-to-br from-brand-indigo/[0.04] to-brand-purple/[0.04] p-6">
            <span class="pointer-events-none absolute right-4 top-2 select-none font-serif text-6xl font-bold leading-none text-brand-indigo/15">"</span>
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(s => (
                <svg viewBox="0 0 20 20" fill="currentColor" class={`h-3.5 w-3.5 ${s <= 4 ? "text-amber-400" : "text-brand-navy/15"}`}>
                  <path d={STAR_PATH}/>
                </svg>
              ))}
            </div>
            <p class="mt-4 flex-1 text-sm font-semibold leading-relaxed text-brand-indigo">
              Oxland CRM is a modern CRM platform designed to be simple, intelligent, and enjoyable
              to use. It streamlines daily tasks, organizes customer interactions, and helps teams
              work more efficiently while making the entire experience smoother and more engaging
              for everyone.
            </p>
          </div>
        </Reveal>

      </div>
    </div>
  </div>
</section>
