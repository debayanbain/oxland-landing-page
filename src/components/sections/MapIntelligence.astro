---
import Reveal from "@/components/Reveal.tsx";
import ScrollScale from "@/components/ScrollScale.tsx";
import Icon from "@/components/Icon.astro";
import MapIntelligenceInteractive from "./MapIntelligenceInteractive.tsx";

const caps = ["Parcel overlays", "Boundaries", "Acquisition zones", "Affected areas", "Layer management"];
---
<section class="relative py-8 sm:py-10">
  <div class="container">
    <div class="overflow-hidden rounded-[36px] border border-white/70 bg-white/70 shadow-card backdrop-blur-md">
      <div class="grid items-stretch gap-0 lg:grid-cols-[0.92fr_1.08fr]">
        <Reveal client:visible variant="blur-up" className="flex flex-col justify-center p-8 sm:p-12 lg:p-14">
          <div class="inline-flex w-max items-center gap-2 rounded-full border border-brand-indigo/15 bg-brand-indigo/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-indigo">
            <span class="relative inline-flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-indigo opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-indigo"></span>
            </span>
            Map-first
          </div>
          <h2 class="mt-5 font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-[44px] sm:leading-[1.05]">
            Turn maps into <span class="text-gradient">operational intelligence</span>
          </h2>
          <p class="mt-5 max-w-[500px] text-lg leading-relaxed text-brand-navy/60">
            Drop a polygon on the cadastre, snap to district boundaries, and Oxland surfaces every parcel inside — KIDE, PNIU, GIS code, ownership — ready for one-click acquisition.
          </p>
          <div class="mt-7 flex flex-wrap gap-2.5">
            {caps.map((c) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-3.5 py-1.5 text-sm font-medium text-brand-navy/75">
                <Icon name="check" size={14} class="text-brand-indigo" />{c}
              </span>
            ))}
          </div>

          <div class="mt-8 grid max-w-[440px] grid-cols-3 divide-x divide-border overflow-hidden rounded-2xl border border-border bg-white/70">
            <div class="px-4 py-3 text-center">
              <div class="font-display text-xl font-extrabold text-brand-navy">142</div>
              <div class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand-navy/50">Parcels</div>
            </div>
            <div class="px-4 py-3 text-center">
              <div class="font-display text-xl font-extrabold text-brand-indigo">68<span class="text-sm font-bold">ha</span></div>
              <div class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand-navy/50">Acquired</div>
            </div>
            <div class="px-4 py-3 text-center">
              <div class="font-display text-xl font-extrabold text-brand-purple">31<span class="text-sm font-bold">ha</span></div>
              <div class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand-navy/50">Affected</div>
            </div>
          </div>
        </Reveal>

        <ScrollScale client:visible from={0.9} lift={40} className="relative p-6 lg:p-8">
          <MapIntelligenceInteractive client:load />
        </ScrollScale>
      </div>
    </div>
  </div>
</section>
