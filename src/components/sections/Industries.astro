---
import Reveal, { RevealGroup, RevealItem } from "@/components/Reveal.tsx";
import Icon from "@/components/Icon.astro";

const industries = [
  { icon: "building", title: "Real Estate", desc: "Developers managing large parcel portfolios." },
  { icon: "route", title: "Infrastructure", desc: "Right-of-way and corridor acquisition at scale." },
  { icon: "sun", title: "Solar Projects", desc: "Site identification and land aggregation." },
  { icon: "zap", title: "Renewable Energy", desc: "Multi-site land operations and approvals." },
  { icon: "factory", title: "Industrial Development", desc: "Estate planning and plot management." },
  { icon: "landmark", title: "Government Projects", desc: "Compliance-ready acquisition workflows." },
  { icon: "scale", title: "Land Consulting", desc: "Litigation, due diligence and advisory." },
  { icon: "users", title: "Enterprise Teams", desc: "Cross-team collaboration with role control." },
];
---
<section id="industries" class="relative py-8 sm:py-10">
  <div class="container">
    <Reveal client:visible variant="blur-up">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-indigo/70">Industries</span>
        <h2 class="mt-3 font-display text-4xl font-extrabold tracking-tight text-brand-navy sm:text-5xl">
          Built for every land-intensive operation
        </h2>
      </div>
    </Reveal>

    <RevealGroup client:visible stagger={0.07} delay={0.05} className="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {industries.map((it) => (
        <RevealItem variant="blur-up" y={22}>
          <div class="group h-full rounded-2xl border border-border bg-white/70 p-6 shadow-card backdrop-blur-sm transition-all hover:-translate-y-1.5 hover:border-brand-indigo/30 hover:shadow-float">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-secondary text-brand-indigo transition-all group-hover:bg-brand-gradient group-hover:text-white">
              <Icon name={it.icon} size={22} />
            </span>
            <h3 class="mt-5 font-display text-lg font-bold text-brand-navy">{it.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-brand-navy/55">{it.desc}</p>
          </div>
        </RevealItem>
      ))}
    </RevealGroup>
  </div>
</section>
