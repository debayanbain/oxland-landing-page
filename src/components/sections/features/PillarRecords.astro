---
import Reveal from "@/components/Reveal.tsx";
import { ArrowRight, FileText, CheckCircle2, History, User } from "lucide-react";

const bullets = [
  "Versioned ownership chain — every mutation, every date",
  "RoR / 7-12 / khasra auto-ingestion",
  "Vernacular OCR across 10 Indian languages",
  "DigiLocker-grade document vault",
];
---

<section id="records" class="relative bg-[#f6f7fc]/60 py-20 sm:py-28">
  <div class="container">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      {/* LEFT — visual */}
      <Reveal client:visible variant="slide-right" delay={0.05}>
        <div class="relative">
          {/* Stacked card backdrop */}
          <div class="absolute inset-0 -translate-x-3 translate-y-3 rounded-3xl border border-brand-navy/10 bg-white opacity-50"></div>
          <div class="absolute inset-0 -translate-x-1.5 translate-y-1.5 rounded-3xl border border-brand-navy/10 bg-white opacity-70"></div>

          <div class="relative overflow-hidden rounded-3xl border border-brand-navy/10 bg-white shadow-float">
            {/* Header */}
            <div class="border-b border-brand-navy/8 bg-gradient-to-r from-brand-indigo/5 to-brand-purple/5 px-6 py-4">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-[10px] font-bold uppercase tracking-wider text-brand-navy/55">Parcel record</div>
                  <div class="mt-0.5 font-display text-base font-extrabold text-brand-navy">Khasra No. 128/2 · Village Garhi</div>
                </div>
                <span class="rounded-full bg-success/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-success">
                  Verified
                </span>
              </div>
            </div>

            {/* Body */}
            <div class="grid grid-cols-2 gap-px bg-brand-navy/8">
              {[
                { k: "Owner", v: "Suresh Kumar Verma" },
                { k: "Area", v: "1.245 hectares" },
                { k: "Survey No.", v: "RS 412/A" },
                { k: "Land type", v: "Agricultural (irrigated)" },
                { k: "Mutation date", v: "12 Mar 2024" },
                { k: "Status", v: "Clear title" },
              ].map((f) => (
                <div class="bg-white p-4">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-brand-navy/45">{f.k}</div>
                  <div class="mt-1 text-sm font-semibold text-brand-navy">{f.v}</div>
                </div>
              ))}
            </div>

            {/* Ownership timeline */}
            <div class="border-t border-brand-navy/8 p-6">
              <div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-brand-navy/55">
                <History size={12} class="text-brand-indigo" />
                Ownership chain
              </div>
              <ol class="mt-3 space-y-3">
                {[
                  { name: "Suresh Kumar Verma", date: "Mar 2024 – present", chip: "Current" },
                  { name: "Ram Lal Verma (Inheritance)", date: "Jul 2011 – Mar 2024", chip: "" },
                  { name: "Govt. land grant", date: "Aug 1972 – Jul 2011", chip: "" },
                ].map((o, idx) => (
                  <li class="relative flex items-start gap-3 pb-3">
                    {idx < 2 && <span class="absolute left-[10px] top-6 h-full w-px bg-gradient-to-b from-brand-indigo/40 to-transparent"></span>}
                    <span class={`relative z-10 grid h-5 w-5 shrink-0 place-items-center rounded-full ${idx === 0 ? "bg-brand-indigo text-white" : "bg-brand-indigo/15 text-brand-indigo"}`}>
                      <User size={10} strokeWidth={2.5} />
                    </span>
                    <div class="flex-1">
                      <div class="flex items-center gap-2 text-sm font-semibold text-brand-navy">
                        {o.name}
                        {o.chip && <span class="rounded-full bg-brand-indigo/10 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-brand-indigo">{o.chip}</span>}
                      </div>
                      <div class="text-[11px] text-brand-navy/55">{o.date}</div>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          {/* Floating doc chip */}
          <div class="absolute -top-4 -right-4 hidden rounded-2xl border border-brand-navy/10 bg-white p-3 shadow-card sm:block">
            <div class="flex items-center gap-2">
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-purple/10 text-brand-purple">
                <FileText size={16} strokeWidth={2.25} />
              </span>
              <div>
                <div class="text-[10px] font-bold uppercase tracking-wider text-brand-navy/55">Docs linked</div>
                <div class="font-display text-sm font-extrabold text-brand-navy">14 · OCR-indexed</div>
              </div>
            </div>
          </div>
        </div>
      </Reveal>

      {/* RIGHT — copy */}
      <Reveal client:visible variant="slide-left">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-indigo/20 bg-brand-indigo/5 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-indigo">
            <span class="font-extrabold">02</span>
            <span class="h-1 w-6 rounded-full bg-brand-indigo/40"></span>
            Records & Ownership
          </div>
          <h2 class="mt-5 font-display text-4xl font-extrabold leading-tight tracking-tight text-brand-navy sm:text-5xl">
            Every parcel,{" "}
            <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">a single source of truth.</span>
          </h2>
          <p class="mt-5 text-base leading-relaxed text-brand-navy/65 sm:text-lg">
            We dissolve the spreadsheet chaos. Oxland ingests RoR, mutation registers, encumbrance certificates and revenue records — auto-indexes them by parcel, and rebuilds the ownership history end-to-end. When legal asks "show me the chain", you have it in one click.
          </p>

          <ul class="mt-7 space-y-3">
            {bullets.map((b) => (
              <li class="flex items-start gap-3 text-sm text-brand-navy/80">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-indigo/10 text-brand-indigo">
                  <CheckCircle2 size={13} strokeWidth={2.5} />
                </span>
                {b}
              </li>
            ))}
          </ul>

          <div class="mt-8 flex items-center gap-3">
            <a href="#" class="group inline-flex items-center gap-2 rounded-full bg-brand-gradient px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition-all hover:shadow-float">
              See the records module
              <ArrowRight size={14} strokeWidth={2.5} class="transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
