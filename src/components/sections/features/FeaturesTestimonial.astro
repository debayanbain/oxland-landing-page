---
import Reveal from "@/components/Reveal.tsx";
import { Quote, Star, TrendingUp } from "lucide-react";

const kpis = [
  { value: "62%", label: "faster acquisition cycle" },
  { value: "1.2M", label: "pages OCR'd in year one" },
  { value: "0", label: "audit findings in MoRTH review" },
];
---

<section class="relative py-20 sm:py-28">
  <div class="container">
    <Reveal client:visible variant="scale">
      <div class="relative overflow-hidden rounded-[36px] border border-brand-navy/8 bg-white shadow-card">
        <div class="pointer-events-none absolute -top-40 -right-40 h-[420px] w-[420px] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(closest-side, rgba(124,58,237,0.32), transparent 70%);"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-40 h-[380px] w-[380px] rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, rgba(47,91,255,0.28), transparent 70%);"></div>
        <div class="pointer-events-none absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #6366f1 1px, transparent 1px); background-size: 22px 22px;"></div>

        <div class="relative grid items-center gap-12 px-8 py-14 lg:grid-cols-[1.4fr_1fr] lg:px-16 lg:py-20">
          <div>
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-brand-indigo to-brand-purple text-white shadow-float">
              <Quote size={24} strokeWidth={2.25} />
            </span>

            <p class="mt-7 font-display text-2xl font-bold leading-snug text-brand-navy sm:text-3xl lg:text-[34px]">
              "What broke us before Oxland was the {`fragmentation`} — GIS in one tool, cases in another, drone data in a third, payments in a fourth.{" "}
              <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">
                Now the parcel record is the single object everything attaches to.
              </span>{" "}
              That alone changed how my team works."
            </p>

            <div class="mt-8 flex items-center gap-4">
              <div class="grid h-12 w-12 place-items-center rounded-full bg-brand-indigo/10 text-brand-indigo font-display font-extrabold text-lg ring-2 ring-white shadow-soft">
                AK
              </div>
              <div>
                <p class="font-display text-base font-extrabold text-brand-navy">Aparna Kulkarni</p>
                <p class="text-sm text-brand-navy/60">Head of Land &amp; Permitting · A leading renewables IPP</p>
              </div>
            </div>

            <div class="mt-5 flex items-center gap-1.5">
              {Array.from({ length: 5 }).map(() => (
                <Star size={16} class="fill-brand-indigo text-brand-indigo" />
              ))}
              <span class="ml-2 text-xs font-semibold text-brand-navy/55">5.0 · verified customer</span>
            </div>
          </div>

          <div class="lg:pl-8 lg:border-l lg:border-brand-navy/8">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-indigo">
              <TrendingUp size={14} />
              Year-one impact
            </div>
            <div class="mt-6 space-y-5">
              {kpis.map((k) => (
                <div>
                  <div class="font-display text-4xl font-extrabold tracking-tight text-brand-navy">
                    <span class="bg-gradient-to-r from-brand-indigo to-brand-purple bg-clip-text text-transparent">{k.value}</span>
                  </div>
                  <div class="mt-1 text-sm text-brand-navy/60">{k.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
